<?xml version="1.0" encoding="utf-8"?>
<!-- Representative ActiveReports Section Report (.rpx) exercising group bands, CanGrow,
     page breaks, a cross-section line, and a sub-report. Hand-authored (not vendor-saved). -->
<Report Name="GroupedSales">
  <PageSettings PaperKind="Letter" Margins="0.75, 0.75, 0.75, 0.75" Orientation="Landscape" />
  <Sections>
    <PageHeader Name="PageHeader1" Height="0.5">
      <Controls>
        <Label Name="title" Left="0" Top="0.05" Width="9" Height="0.35" Text="Sales by Region" Font-FamilyName="Calibri" Font-Size="16" Font-Bold="True" />
      </Controls>
    </PageHeader>
    <GroupHeader Name="RegionHeader" Height="0.4" DataField="Region" NewPage="Before">
      <Controls>
        <TextBox Name="regionName" Left="0" Top="0.05" Width="4" Height="0.3" DataField="Region" Font-Bold="True" ForeColor="0, 51, 102" />
        <CrossSectionLine Name="groupRule" X1="0" Y1="0.38" X2="9" Y2="0.38" LineWeight="1" LineColor="0, 51, 102" />
      </Controls>
    </GroupHeader>
    <Detail Name="Detail1" Height="0.3">
      <Controls>
        <TextBox Name="product" Left="0.2" Top="0" Width="4" Height="0.25" DataField="Product" CanGrow="True" />
        <TextBox Name="qty" Left="4.5" Top="0" Width="1.5" Height="0.25" DataField="Quantity" Alignment="Right" />
        <TextBox Name="total" Left="6.5" Top="0" Width="2" Height="0.25" DataField="Total" Alignment="Right" OutputFormat="C2" />
      </Controls>
    </Detail>
    <GroupFooter Name="RegionFooter" Height="0.4">
      <Controls>
        <Label Name="subtotalLabel" Left="4.5" Top="0.05" Width="1.5" Height="0.25" Text="Subtotal:" Alignment="Right" Font-Bold="True" />
        <TextBox Name="subtotal" Left="6.5" Top="0.05" Width="2" Height="0.25" DataField="RegionTotal" Alignment="Right" OutputFormat="C2" Font-Bold="True" />
      </Controls>
    </GroupFooter>
    <ReportFooter Name="ReportFooter1" Height="1.2">
      <Controls>
        <Label Name="notesTitle" Left="0" Top="0" Width="3" Height="0.25" Text="Appendix" Font-Bold="True" />
        <SubReport Name="appendix" Left="0" Top="0.3" Width="9" Height="0.8" ReportName="SalesAppendix.rpx" />
      </Controls>
    </ReportFooter>
    <PageFooter Name="PageFooter1" Height="0.3">
      <Controls>
        <Label Name="pageinfo" Left="8" Top="0.05" Width="1" Height="0.2" Text="Page" Alignment="Right" />
      </Controls>
    </PageFooter>
  </Sections>
</Report>
