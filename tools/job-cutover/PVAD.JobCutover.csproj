<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName Condition="'$(LegacyRoot)' == ''">PVAD.JobCutover</AssemblyName>
    <AssemblyName Condition="'$(LegacyRoot)' != ''">PXA.JobCutover</AssemblyName>
    <DefineConstants Condition="'$(LegacyRoot)' != ''">$(DefineConstants);LEGACY</DefineConstants>
    <OutputPath Condition="'$(LegacyRoot)' != ''">bin/legacy/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(LegacyRoot)' != ''">obj/legacy/$(Configuration)/net10.0/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(LegacyRoot)' == ''">
    <ProjectReference Include="../../PVAD.WebApi/PVAD.WebApi.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LegacyRoot)' != ''">
    <ProjectReference Include="$(LegacyRoot)/PXA.WebApi/PXA.WebApi.csproj" />
  </ItemGroup>
</Project>
