{
  "name": "pxa-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing Power Dox Automation's element catalog, design schema, docs, and validate/render tools to AI agents.",
  "bin": {
    "pxa-mcp": "dist/pxa-mcp.js",
    "pxa-mcp-server": "dist/pxa-mcp-server.js",
    "canvas-mcp": "dist/pxa-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "start:remote": "tsx src/remote.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "smoke": "tsx smoke.ts",
    "smoke:dist": "tsx smoke.ts --dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "hono": "4.12.34"
  }
}
