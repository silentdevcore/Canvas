<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(PvadProtectedMigrationConsumer)' != 'true'">
    <ProjectReference Include="../../../src/Migrations/PDF/PVAD.Migration.Pdf.Viewer.Nutrient/PVAD.Migration.Pdf.Viewer.Nutrient.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PvadProtectedMigrationConsumer)' == 'true'">
    <PackageReference Include="PVAD.Migration.Pdf.Viewer.Nutrient" Version="$(PvadVersion)" />
  </ItemGroup>
</Project>
