<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);PVAD0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="PVAD.NativeLicenseTestFixtures" />
    <Compile Include="../NativeSurfaceCoverage.cs" Link="NativeSurfaceCoverage.cs" />
    <Content Include="../../../assets/fonts/liberation/*" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../../src/Importing/PVAD.FileImporter/PVAD.FileImporter.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
</Project>
