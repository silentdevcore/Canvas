<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);PVAD0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../../assets/fonts/liberation/*" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../../src/Importing/PVAD.FileImporter/PVAD.FileImporter.csproj" />
  </ItemGroup>
</Project>
