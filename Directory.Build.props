<Project>
  <PropertyGroup>
    <PvadVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</PvadVersion>
    <Version>$(PvadVersion)</Version>
    <VersionPrefix>$(PvadVersion)</VersionPrefix>
    <PackageVersion>$(PvadVersion)</PackageVersion>
    <AssemblyVersion>$(PvadVersion)</AssemblyVersion>
    <FileVersion>$(PvadVersion)</FileVersion>
    <InformationalVersion Condition="'$(PvadBuildMetadata)' == ''">$(PvadVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(PvadBuildMetadata)' != ''">$(PvadVersion)+$(PvadBuildMetadata)</InformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
