import React, { useState } from 'react';
import { DndContext, useDroppable } from '@dnd-kit/core';

const Canvas: React.FC = () => {
  const [elements, setElements] = useState<any[]>([]);
  const { setNodeRef } = useDroppable({ id: 'canvas' });

  function handleDragEnd(event: any) {
    const { active } = event;
    if (active) {
      setElements((els) => [...els, { type: active.id, id: Date.now() }]);
    }
  }

  return (
    <DndContext onDragEnd={handleDragEnd}>
      <main className="canvas" ref={setNodeRef}>
        {elements.length === 0 && <div className="canvas-placeholder">Drop elements here</div>}
        {elements.map((el) => (
          <div key={el.id} className="canvas-element">{el.type}</div>
        ))}
      </main>
    </DndContext>
  );
};

export default Canvas;
