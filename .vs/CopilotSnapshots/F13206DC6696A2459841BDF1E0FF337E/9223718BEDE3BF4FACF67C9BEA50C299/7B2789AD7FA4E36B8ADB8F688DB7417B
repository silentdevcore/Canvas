import React from 'react';
import { useDesignerStore } from './store';

const PropertiesPanel: React.FC = () => {
  const { selectedId, elements, updateElementProps } = useDesignerStore();
  if (!selectedId) return (
    <aside className="properties-panel">
      <h2>Properties</h2>
      <div>Select an element</div>
    </aside>
  );

  const element = elements[selectedId];
  if (!element) return null;

  function handleChange(e: React.ChangeEvent<HTMLInputElement>) {
    const { name, value } = e.target;
    updateElementProps(selectedId, {
      [name]: name === 'fontSize' ? parseInt(value, 10) : value,
    });
  }

  return (
    <aside className="properties-panel">
      <h2>Properties</h2>
      <div><strong>Type:</strong> {element.type}</div>
      {element.type === 'Text' && (
        <>
          <label>
            Text:
            <input
              name="text"
              value={element.props.text}
              onChange={handleChange}
              type="text"
            />
          </label>
          <label>
            Font Size:
            <input
              name="fontSize"
              value={element.props.fontSize}
              onChange={handleChange}
              type="number"
              min={8}
              max={72}
            />
          </label>
        </>
      )}
      {/* Add more property editors for other types as needed */}
    </aside>
  );
};

export default PropertiesPanel;
