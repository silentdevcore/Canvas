import React from 'react';
import { DndContext, useDroppable } from '@dnd-kit/core';
import { useDesignerStore } from './store';

const Canvas: React.FC = () => {
  const { rootIds, elements, addElement } = useDesignerStore();
  const { setNodeRef } = useDroppable({ id: 'canvas' });

  function handleDragEnd(event: any) {
    const { active } = event;
    if (active) {
      addElement(active.id);
    }
  }

  return (
    <DndContext onDragEnd={handleDragEnd}>
      <main className="canvas" ref={setNodeRef}>
        {rootIds.length === 0 && <div className="canvas-placeholder">Drop elements here</div>}
        {rootIds.map((id) => (
          <div key={id} className="canvas-element">{elements[id].type}</div>
        ))}
      </main>
    </DndContext>
  );
};

export default Canvas;
