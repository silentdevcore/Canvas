.ui-designer-layout {
  display: flex;
  height: 100vh;
}

.sidebar {
  width: 200px;
  background: #f4f4f4;
  border-right: 1px solid #ddd;
  padding: 1rem;
}

.canvas {
  flex: 1;
  background: #fff;
  padding: 1rem;
  overflow: auto;
}

.properties-panel {
  width: 250px;
  background: #fafafa;
  border-left: 1px solid #ddd;
  padding: 1rem;
}

.draggable-element {
  background: #e0e7ff;
  border: 1px solid #b4b4b4;
  border-radius: 4px;
  padding: 0.5rem 1rem;
  margin-bottom: 0.5rem;
  cursor: grab;
  user-select: none;
}

.canvas-placeholder {
  color: #aaa;
  text-align: center;
  margin-top: 2rem;
}

.canvas-element {
  background: #f0fdf4;
  border: 1px solid #b4b4b4;
  border-radius: 4px;
  padding: 0.75rem 1.25rem;
  margin-bottom: 0.75rem;
}

.canvas-element.selected {
  outline: 2px solid #2563eb;
  background: #e0f2fe;
}
