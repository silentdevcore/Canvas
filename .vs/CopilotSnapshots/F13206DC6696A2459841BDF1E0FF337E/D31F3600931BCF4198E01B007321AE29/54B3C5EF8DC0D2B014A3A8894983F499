.ui-designer-layout {
  display: flex;
  height: 100vh;
}

.sidebar {
  width: 200px;
  background: #f4f4f4;
  border-right: 1px solid #ddd;
  padding: 1rem;
}

.canvas {
  flex: 1;
  background: #fff;
  padding: 1rem;
  overflow: auto;
}

.properties-panel {
  width: 250px;
  background: #fafafa;
  border-left: 1px solid #ddd;
  padding: 1rem;
}
