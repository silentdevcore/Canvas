using Canvas.Pdf.Serialization;

namespace Canvas.Pdf;

public sealed class PdfDocument
{
    private readonly List<PdfPage> _pages = new();
    private readonly List<PdfBookmark> _bookmarks = new();

    public PdfDocument(PdfStandardFont defaultFont = PdfStandardFont.Helvetica)
    {
        DefaultFont = defaultFont;
    }

    public IReadOnlyList<PdfPage> Pages => _pages;

    public PdfStandardFont DefaultFont { get; set; }

    public PdfDocumentInfo Info { get; } = new();

    internal IReadOnlyList<PdfBookmark> Bookmarks => _bookmarks;

    public PdfPage AddPage(double width = PdfPageSizes.A4Width, double height = PdfPageSizes.A4Height)
    {
        var page = new PdfPage(width, height, DefaultFont);
        _pages.Add(page);
        return page;
    }

    public void AddBookmark(string title, int pageNumber)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            throw new ArgumentException("Bookmark title cannot be null or empty.", nameof(title));
        }

        if (pageNumber <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(pageNumber), "Page number must be greater than zero.");
        }

        _bookmarks.Add(new PdfBookmark(title, pageNumber));
    }

    public IReadOnlyList<PdfPage> AddTableOfContents(PdfTableOfContentsOptions? options = null)
    {
        options ??= PdfTableOfContentsOptions.Default;

        if (options.PageWidth <= 0 || options.PageHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Page dimensions must be greater than zero.");
        }

        if (options.TitleFontSize <= 0 || options.EntryFontSize <= 0 || options.EntryLineHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font sizes and line height must be greater than zero.");
        }

        if (options.MarginLeft < 0 || options.MarginRight < 0 || options.MarginTop < 0 || options.MarginBottom < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Margins cannot be negative.");
        }

        if (_bookmarks.Count == 0)
        {
            return Array.Empty<PdfPage>();
        }

        if (options.MarginLeft + options.MarginRight >= options.PageWidth)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Horizontal margins exceed TOC page width.");
        }

        if (options.MarginTop + options.MarginBottom >= options.PageHeight)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Vertical margins exceed TOC page height.");
        }

        var tocPages = new List<PdfPage>();
        var font = ResolveTableOfContentsFont(options);
        var textColor = options.TextColor ?? PdfColor.Black;
        var validBookmarks = _bookmarks
            .Where(bookmark => bookmark.PageNumber > 0 && bookmark.PageNumber <= _pages.Count)
            .ToList();

        if (validBookmarks.Count == 0)
        {
            return Array.Empty<PdfPage>();
        }

        var currentPage = AddPage(options.PageWidth, options.PageHeight);
        tocPages.Add(currentPage);

        var currentY = currentPage.Height - options.MarginTop;
        currentPage.DrawText(options.Title, options.MarginLeft, currentY, new PdfDrawTextOptions
        {
            Font = font,
            FontSize = options.TitleFontSize,
            FillColor = textColor
        });

        currentY -= options.TitleFontSize + options.EntryLineHeight;

        foreach (var bookmark in validBookmarks)
        {
            if (currentY - options.EntryFontSize < options.MarginBottom)
            {
                currentPage = AddPage(options.PageWidth, options.PageHeight);
                tocPages.Add(currentPage);
                currentY = currentPage.Height - options.MarginTop;
            }

            var pageNumberText = bookmark.PageNumber.ToString();
            var pageNumberWidth = EstimateTextWidth(pageNumberText, options.EntryFontSize, font);
            var pageNumberX = currentPage.Width - options.MarginRight - pageNumberWidth;
            var titleX = options.MarginLeft;
            var availableTitleWidth = pageNumberX - titleX - 12;

            var displayTitle = FitTextToWidth(bookmark.Title, availableTitleWidth, options.EntryFontSize, font);

            currentPage.DrawText(displayTitle, titleX, currentY, new PdfDrawTextOptions
            {
                Font = font,
                FontSize = options.EntryFontSize,
                FillColor = textColor
            });

            currentPage.DrawText(pageNumberText, pageNumberX, currentY, new PdfDrawTextOptions
            {
                Font = font,
                FontSize = options.EntryFontSize,
                FillColor = textColor
            });

            var linkWidth = currentPage.Width - options.MarginLeft - options.MarginRight;
            currentPage.AddPageLink(options.MarginLeft, currentY - 2, linkWidth, options.EntryLineHeight, bookmark.PageNumber);

            currentY -= options.EntryLineHeight;
        }

        return tocPages;
    }

    public PdfFlowContext CreateFlow(PdfFlowOptions? options = null)
    {
        options ??= PdfFlowOptions.Default;

        if (options.PageWidth <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "PageWidth must be greater than zero.");
        }

        if (options.PageHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "PageHeight must be greater than zero.");
        }

        if (options.MarginLeft < 0 || options.MarginRight < 0 || options.MarginTop < 0 || options.MarginBottom < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Margins cannot be negative.");
        }

        if (options.MarginLeft + options.MarginRight >= options.PageWidth)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Horizontal margins exceed page width.");
        }

        if (options.MarginTop + options.MarginBottom >= options.PageHeight)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Vertical margins exceed page height.");
        }

        return new PdfFlowContext(this, options);
    }

    public void AddPageNumbers(PdfPageNumberOptions? options = null)
    {
        options ??= PdfPageNumberOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font size must be greater than zero.");
        }

        if (options.MarginX < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "MarginX cannot be negative.");
        }

        if (_pages.Count == 0)
        {
            return;
        }

        var endNumber = options.StartNumber + _pages.Count - 1;

        for (var index = 0; index < _pages.Count; index++)
        {
            var page = _pages[index];
            var number = options.StartNumber + index;
            var text = options.ShowTotalPages
                ? $"{options.Prefix}{number}{options.Separator}{endNumber}{options.Suffix}"
                : $"{options.Prefix}{number}{options.Suffix}";

            var font = ResolvePageNumberFont(page, options);
            var textWidth = EstimateTextWidth(text, options.FontSize, font);
            var x = ResolveAlignedX(page.Width, options.MarginX, textWidth, options.Alignment);

            page.DrawText(text, x, options.Y, new PdfDrawTextOptions
            {
                FontSize = options.FontSize,
                Font = font,
                FillColor = options.FillColor
            });
        }
    }

    public void AddTextWatermark(string text, PdfWatermarkOptions? options = null)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            throw new ArgumentException("Watermark text cannot be null or empty.", nameof(text));
        }

        options ??= PdfWatermarkOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "FontSize must be greater than zero.");
        }

        if (_pages.Count == 0)
        {
            return;
        }

        foreach (var page in _pages)
        {
            var font = ResolveWatermarkFont(page, options);
            var textWidth = EstimateTextWidth(text, options.FontSize, font);
            var x = ((page.Width - textWidth) / 2) + options.OffsetX;
            var y = (page.Height / 2) + options.OffsetY;

            page.DrawText(text, x, y, new PdfDrawTextOptions
            {
                FontSize = options.FontSize,
                Font = font,
                FillColor = options.FillColor,
                RotationDegrees = options.RotationDegrees
            });
        }
    }

    public void AddHeadersAndFooters(PdfHeaderFooterOptions? options = null)
    {
        options ??= PdfHeaderFooterOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font size must be greater than zero.");
        }

        if (options.MarginX < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "MarginX cannot be negative.");
        }

        if (options.HeaderTopMargin < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "HeaderTopMargin cannot be negative.");
        }

        if (options.FooterY < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "FooterY cannot be negative.");
        }

        if (_pages.Count == 0)
        {
            return;
        }

        var endNumber = options.StartNumber + _pages.Count - 1;

        for (var index = 0; index < _pages.Count; index++)
        {
            var page = _pages[index];
            var number = options.StartNumber + index;
            var font = ResolveHeaderFooterFont(page, options);

            if (!string.IsNullOrWhiteSpace(options.HeaderTemplate))
            {
                var headerText = ResolveTemplate(options.HeaderTemplate, number, endNumber);
                var headerTextWidth = EstimateTextWidth(headerText, options.FontSize, font);
                var headerX = ResolveAlignedX(page.Width, options.MarginX, headerTextWidth, options.HeaderAlignment);
                var headerY = page.Height - options.HeaderTopMargin;

                page.DrawText(headerText, headerX, headerY, new PdfDrawTextOptions
                {
                    FontSize = options.FontSize,
                    Font = font,
                    FillColor = options.FillColor
                });
            }

            if (!string.IsNullOrWhiteSpace(options.FooterTemplate))
            {
                var footerText = ResolveTemplate(options.FooterTemplate, number, endNumber);
                var footerTextWidth = EstimateTextWidth(footerText, options.FontSize, font);
                var footerX = ResolveAlignedX(page.Width, options.MarginX, footerTextWidth, options.FooterAlignment);

                page.DrawText(footerText, footerX, options.FooterY, new PdfDrawTextOptions
                {
                    FontSize = options.FontSize,
                    Font = font,
                    FillColor = options.FillColor
                });
            }
        }
    }

    public void Save(string filePath)
    {
        Save(filePath, PdfSaveOptions.Default);
    }

    public void Save(string filePath, PdfSaveOptions options)
    {
        ArgumentNullException.ThrowIfNull(options);

        var writer = new PdfWriter();
        var bytes = writer.Write(this, options);
        File.WriteAllBytes(filePath, bytes);
    }

    private static double ResolveAlignedX(double pageWidth, double marginX, double textWidth, PdfTextAlignment alignment)
    {
        var x = alignment switch
        {
            PdfTextAlignment.Left or PdfTextAlignment.Justify => marginX,
            PdfTextAlignment.Center => (pageWidth - textWidth) / 2,
            PdfTextAlignment.Right => pageWidth - marginX - textWidth,
            _ => throw new ArgumentOutOfRangeException(nameof(alignment), "Unsupported text alignment.")
        };

        return x < 0 ? 0 : x;
    }

    private static PdfStandardFont ResolvePageNumberFont(PdfPage page, PdfPageNumberOptions options)
    {
        return options.Font
            ?? (options.FontFamily is { } family
                ? PdfStandardFonts.FromStyle(family, options.Bold, options.Italic)
                : page.DefaultFont);
    }

    private static PdfStandardFont ResolveWatermarkFont(PdfPage page, PdfWatermarkOptions options)
    {
        return options.Font
            ?? (options.FontFamily is { } family
                ? PdfStandardFonts.FromStyle(family, options.Bold, options.Italic)
                : page.DefaultFont);
    }

    private static PdfStandardFont ResolveHeaderFooterFont(PdfPage page, PdfHeaderFooterOptions options)
    {
        return options.Font
            ?? (options.FontFamily is { } family
                ? PdfStandardFonts.FromStyle(family, options.Bold, options.Italic)
                : page.DefaultFont);
    }

    private static string ResolveTemplate(string template, int number, int total)
    {
        return template
            .Replace("{page}", number.ToString(), StringComparison.Ordinal)
            .Replace("{total}", total.ToString(), StringComparison.Ordinal);
    }

    private PdfStandardFont ResolveTableOfContentsFont(PdfTableOfContentsOptions options)
    {
        return options.Font
            ?? (options.FontFamily is { } family
                ? PdfStandardFonts.FromStyle(family, options.Bold, options.Italic)
                : DefaultFont);
    }

    private static string FitTextToWidth(string text, double width, double fontSize, PdfStandardFont font)
    {
        if (width <= 0)
        {
            return string.Empty;
        }

        if (EstimateTextWidth(text, fontSize, font) <= width)
        {
            return text;
        }

        const string ellipsis = "...";
        var ellipsisWidth = EstimateTextWidth(ellipsis, fontSize, font);

        if (ellipsisWidth > width)
        {
            return string.Empty;
        }

        var chars = text.ToCharArray();
        var length = chars.Length;

        while (length > 0)
        {
            var candidate = new string(chars, 0, length) + ellipsis;
            if (EstimateTextWidth(candidate, fontSize, font) <= width)
            {
                return candidate;
            }

            length--;
        }

        return ellipsis;
    }

    private static double EstimateTextWidth(string text, double fontSize, PdfStandardFont font)
    {
        var avgCharacterWidthFactor = font switch
        {
            PdfStandardFont.Courier or PdfStandardFont.CourierBold or PdfStandardFont.CourierOblique or PdfStandardFont.CourierBoldOblique => 0.6,
            PdfStandardFont.TimesRoman or PdfStandardFont.TimesBold or PdfStandardFont.TimesItalic or PdfStandardFont.TimesBoldItalic => 0.5,
            _ => 0.52
        };

        return text.Length * fontSize * avgCharacterWidthFactor;
    }
}
