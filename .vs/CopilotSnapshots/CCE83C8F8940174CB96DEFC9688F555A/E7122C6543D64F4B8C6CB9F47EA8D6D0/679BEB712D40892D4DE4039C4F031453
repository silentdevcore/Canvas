## 20. End-to-End Example

```csharp
using Canvas.Pdf;

var doc = new PdfDocument(defaultFont: PdfStandardFonts.FromStyle(PdfFontFamily.Times));
doc.Info.Title = "Canvas.Pdf Example";

var page = doc.AddPage();
page.DrawRectangle(80, 640, 430, 90, fill: true, strokeColor: new PdfColor(0.1, 0.2, 0.5), fillColor: new PdfColor(0.92, 0.95, 1));
page.DrawText("Hello World", 100, 700, new PdfDrawTextOptions
{
    FontSize = 18,
    FontFamily = PdfFontFamily.Helvetica,
    Bold = true,
    FillColor = new PdfColor(0.1, 0.2, 0.5)
});
page.AddWebLink(x: 100, y: 696, width: 120, height: 18, url: "https://learn.microsoft.com/dotnet/");
page.DrawImage("assets/logo.png", x: 100, y: 640, width: 120, height: 80);

var p = page.DrawParagraph(
    "This is wrapped and justified paragraph text generated directly by Canvas.Pdf.",
    x: 100,
    y: 620,
    maxWidth: 360,
    new PdfParagraphOptions
    {
        FontSize = 12,
        Alignment = PdfTextAlignment.Justify,
        LineHeight = 16
    });

page.DrawText($"Lines: {p.LineCount}", 100, p.BottomY - 20, fontSize: 10, fontFamily: PdfFontFamily.Courier);

var flow = doc.CreateFlow(new PdfFlowOptions { MarginLeft = 60, MarginRight = 60 });
flow.AddTextLine("Flow page");
flow.AddParagraph("This paragraph is added through the flow API.");

doc.AddPageNumbers(new PdfPageNumberOptions { Y = 18, Alignment = PdfTextAlignment.Center });
doc.AddHeadersAndFooters(new PdfHeaderFooterOptions { HeaderTemplate = "Canvas.Pdf Example", FooterTemplate = "" });
doc.AddBookmark("Overview", 1);
doc.AddTableOfContents();
doc.AddTextWatermark("CONFIDENTIAL");

doc.Save("output.pdf", new PdfSaveOptions { CompressContentStreams = true });
```

