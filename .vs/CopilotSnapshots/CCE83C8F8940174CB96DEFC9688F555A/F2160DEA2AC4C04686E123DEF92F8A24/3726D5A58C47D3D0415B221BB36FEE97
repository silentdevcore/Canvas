namespace Canvas.Pdf;

public sealed class PdfTableOfContentsOptions
{
    public static PdfTableOfContentsOptions Default { get; } = new();

    public string Title { get; init; } = "Table of Contents";

    public PdfTextAlignment TitleAlignment { get; init; } = PdfTextAlignment.Left;

    public double PageWidth { get; init; } = PdfPageSizes.A4Width;

    public double PageHeight { get; init; } = PdfPageSizes.A4Height;

    public double MarginLeft { get; init; } = 60;

    public double MarginRight { get; init; } = 60;

    public double MarginTop { get; init; } = 70;

    public double MarginBottom { get; init; } = 50;

    public double TitleFontSize { get; init; } = 20;

    public double EntryFontSize { get; init; } = 11;

    public double EntryLineHeight { get; init; } = 18;

    public bool ShowHierarchyIndent { get; init; } = true;

    public double EntryIndentPerLevel { get; init; } = 12;

    public bool ShowLeaderDots { get; init; } = true;

    public string LeaderPattern { get; init; } = ".";

    public double LeaderGap { get; init; } = 8;

    public double TitleBottomSpacing { get; init; } = 18;

    public PdfStandardFont? Font { get; init; }

    public PdfFontFamily? FontFamily { get; init; } = PdfFontFamily.Helvetica;

    public bool Bold { get; init; }

    public bool Italic { get; init; }

    public IPdfColor? TextColor { get; init; } = PdfColor.Black;

    public IPdfColor? TitleColor { get; init; }

    public PdfTableOfContentsPlacement Placement { get; init; } = PdfTableOfContentsPlacement.End;
}
