    private static string ResolveTemplate(PdfDocument document, string template, int number, int total, string section, int sectionPage, int sectionTotal, int sectionIndex, int sections, bool suppressEmptySectionTokens)
    {
        var now = DateTimeOffset.UtcNow;
        var creationDate = document.Info.CreationDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        var modificationDate = document.Info.ModificationDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

        var resolved = template
            .Replace("{page}", number.ToString(), StringComparison.Ordinal)
            .Replace("{total}", total.ToString(), StringComparison.Ordinal)
            .Replace("{date}", now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
            .Replace("{time}", now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
            .Replace("{title}", document.Info.Title ?? string.Empty, StringComparison.Ordinal)
            .Replace("{author}", document.Info.Author ?? string.Empty, StringComparison.Ordinal)
            .Replace("{subject}", document.Info.Subject ?? string.Empty, StringComparison.Ordinal)
            .Replace("{creator}", document.Info.Creator ?? string.Empty, StringComparison.Ordinal)
            .Replace("{producer}", document.Info.Producer ?? string.Empty, StringComparison.Ordinal)
            .Replace("{creationdate}", creationDate, StringComparison.Ordinal)
            .Replace("{moddate}", modificationDate, StringComparison.Ordinal)
            .Replace("{section}", section, StringComparison.Ordinal)
            .Replace("{sectionpage}", sectionPage.ToString(), StringComparison.Ordinal)
            .Replace("{sectiontotal}", sectionTotal.ToString(), StringComparison.Ordinal)
            .Replace("{sectionindex}", sectionIndex.ToString(), StringComparison.Ordinal)
            .Replace("{sections}", sections.ToString(), StringComparison.Ordinal);

        if (!suppressEmptySectionTokens)
        {
            return resolved;
        }

        if (!string.IsNullOrWhiteSpace(section))
        {
            return resolved;
        }

        return CleanupEmptySectionTemplate(resolved);
    }

    private static string CleanupEmptySectionTemplate(string template)
    {
        var cleaned = template
            .Replace("Section 1/1:", string.Empty, StringComparison.Ordinal)
            .Replace("Section 1/1", string.Empty, StringComparison.Ordinal)
            .Replace("()", string.Empty, StringComparison.Ordinal)
            .Replace(" -  - ", " - ", StringComparison.Ordinal)
            .Replace("  ", " ", StringComparison.Ordinal)
            .Replace("\n\n", "\n", StringComparison.Ordinal)
            .Trim();

        return cleaned;
    }

    private static void DrawHeaderOrFooterLines(
        PdfPage page,
        string text,
        PdfStandardFont font,
        double fontSize,
        double marginX,
        PdfTextAlignment alignment,
        double startY,
        double lineSpacing,
        IPdfColor? fillColor,
        bool header)
    {
        var lines = text.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');

        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var lineWidth = EstimateTextWidth(line, fontSize, font);
            var x = ResolveAlignedX(page.Width, marginX, lineWidth, alignment);
            var y = header
                ? startY - (i * lineSpacing)
                : startY + (i * lineSpacing);

            page.DrawText(line, x, y, new PdfDrawTextOptions
            {
                FontSize = fontSize,
                Font = font,
                FillColor = fillColor
            });
        }
    }

    private string ResolveSectionName(int pageNumber)
    {
        if (_sections.Count == 0)
        {
            return string.Empty;
        }

        var current = _sections
            .Where(section => section.StartPageNumber <= pageNumber)
            .OrderBy(section => section.StartPageNumber)
            .LastOrDefault();

        return current?.Name ?? string.Empty;
    }

    private int ResolveSectionPageNumber(int pageNumber)
    {
        if (_sections.Count == 0)
        {
            return pageNumber;
        }

        var current = _sections
            .Where(section => section.StartPageNumber <= pageNumber)
            .OrderBy(section => section.StartPageNumber)
            .LastOrDefault();

        if (current is null)
        {
            return pageNumber;
        }

        return (pageNumber - current.StartPageNumber) + 1;
    }

    private int ResolveSectionTotalPages(int pageNumber)
    {
        if (_sections.Count == 0)
        {
            return _pages.Count;
        }

        var ordered = _sections
            .OrderBy(section => section.StartPageNumber)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
        {
            var current = ordered[i];
            var nextStart = i < ordered.Count - 1 ? ordered[i + 1].StartPageNumber : (_pages.Count + 1);

            if (pageNumber >= current.StartPageNumber && pageNumber < nextStart)
            {
                return Math.Max(1, nextStart - current.StartPageNumber);
            }
        }

        return _pages.Count;
    }

    private int ResolveSectionIndex(int pageNumber)
    {
        if (_sections.Count == 0)
        {
            return 1;
        }

        var ordered = _sections
            .OrderBy(section => section.StartPageNumber)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
        {
            var current = ordered[i];
            var nextStart = i < ordered.Count - 1 ? ordered[i + 1].StartPageNumber : (_pages.Count + 1);

            if (pageNumber >= current.StartPageNumber && pageNumber < nextStart)
            {
                return i + 1;
            }
        }

        return 1;
    }

