using Canvas.Pdf.Serialization;

namespace Canvas.Pdf;

public sealed class PdfDocument
{
    private readonly List<PdfPage> _pages = new();
    private readonly List<PdfBookmark> _bookmarks = new();
    private readonly List<PdfNamedDestination> _namedDestinations = new();
    private readonly HashSet<PdfPage> _tableOfContentsPages = new();
    private readonly List<PdfSection> _sections = new();
    private PdfGenerationDiagnostics? _lastDiagnostics;
    private PdfViewerPreferencesOptions _viewerPreferences = PdfViewerPreferencesOptions.Default;

    public PdfDocument(PdfStandardFont defaultFont = PdfStandardFont.Helvetica)
    {
        DefaultFont = defaultFont;
    }

    public IReadOnlyList<PdfPage> Pages => _pages;

    public PdfStandardFont DefaultFont { get; set; }

    public PdfDocumentInfo Info { get; } = new();

    public PdfGenerationDiagnostics? LastDiagnostics => _lastDiagnostics;

    public IReadOnlyList<PdfSectionInfo> GetSections()
    {
        return _sections
            .OrderBy(section => section.StartPageNumber)
            .Select(section => new PdfSectionInfo
            {
                Name = section.Name,
                StartPageNumber = section.StartPageNumber
            })
            .ToList();
    }

    public IReadOnlyList<PdfNamedDestinationInfo> GetNamedDestinations()
    {
        return _namedDestinations
            .OrderBy(destination => destination.Name, StringComparer.OrdinalIgnoreCase)
            .Select(destination => new PdfNamedDestinationInfo
            {
                Name = destination.Name,
                PageNumber = destination.PageNumber,
                Y = destination.Y
            })
            .ToList();
    }

    internal IReadOnlyList<PdfBookmark> Bookmarks => _bookmarks;

    internal IReadOnlyList<PdfNamedDestination> NamedDestinations => _namedDestinations;

    internal int TableOfContentsPageCount => _tableOfContentsPages.Count;

    internal IReadOnlyList<PdfSection> Sections => _sections;

    internal PdfViewerPreferencesOptions ViewerPreferences => _viewerPreferences;

    public PdfPage AddPage(double width = PdfPageSizes.A4Width, double height = PdfPageSizes.A4Height)
    {
        var page = new PdfPage(width, height, DefaultFont);
        _pages.Add(page);
        return page;
    }

    public PdfPage AddPage(PdfPagePreset preset, bool landscape = false)
    {
        var (width, height) = preset switch
        {
            PdfPagePreset.A4 => (PdfPageSizes.A4Width, PdfPageSizes.A4Height),
            PdfPagePreset.A3 => (PdfPageSizes.A3Width, PdfPageSizes.A3Height),
            PdfPagePreset.Letter => (PdfPageSizes.LetterWidth, PdfPageSizes.LetterHeight),
            _ => throw new ArgumentOutOfRangeException(nameof(preset), preset, "Unsupported page preset.")
        };

        if (landscape)
        {
            (width, height) = PdfPageSizes.Landscape(width, height);
        }

        return AddPage(width, height);
    }

    public PdfPage AddPageRotated(int rotationDegrees, double width = PdfPageSizes.A4Width, double height = PdfPageSizes.A4Height)
    {
        if (rotationDegrees % 90 != 0)
        {
            throw new ArgumentOutOfRangeException(nameof(rotationDegrees), "Rotation must be a multiple of 90.");
        }

        var page = AddPage(width, height);
        page.RotationDegrees = rotationDegrees;
        return page;
    }

    public void SetViewerPreferences(PdfViewerPreferencesOptions options)
    {
        ArgumentNullException.ThrowIfNull(options);

        if (options.OpenPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "OpenPageNumber must be greater than zero when provided.");
        }

        if (options.OpenZoomPercent is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "OpenZoomPercent must be greater than zero when provided.");
        }

        _viewerPreferences = options;
    }

    public void SetPageBackground(IPdfColor color)
    {
        ArgumentNullException.ThrowIfNull(color);

        foreach (var page in _pages)
        {
            page.DrawRectangle(
                x: 0,
                y: 0,
                width: page.Width,
                height: page.Height,
                lineWidth: 1,
                fill: true,
                strokeColor: color,
                fillColor: color);
        }
    }

    public void AddBookmark(string title, int pageNumber, int level = 1)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            throw new ArgumentException("Bookmark title cannot be null or empty.", nameof(title));
        }

        if (pageNumber <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(pageNumber), "Page number must be greater than zero.");
        }

        if (level <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(level), "Bookmark level must be greater than zero.");
        }

        _bookmarks.Add(new PdfBookmark(title, pageNumber, level));
    }

    public void AddSection(string name, int startPageNumber)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            throw new ArgumentException("Section name cannot be null or empty.", nameof(name));
        }

        if (startPageNumber <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(startPageNumber), "Section start page must be greater than zero.");
        }

        _sections.Add(new PdfSection(name, startPageNumber));
    }

    public void AddNamedDestination(string name, int pageNumber, double? y = null)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            throw new ArgumentException("Destination name cannot be null or empty.", nameof(name));
        }

        if (pageNumber <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(pageNumber), "Page number must be greater than zero.");
        }

        if (y is < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(y), "Destination Y must be zero or greater when provided.");
        }

        var existing = _namedDestinations.FirstOrDefault(destination =>
            destination.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

        if (existing is not null)
        {
            existing.PageNumber = pageNumber;
            existing.Y = y;
            return;
        }

        _namedDestinations.Add(new PdfNamedDestination(name, pageNumber, y));
    }

    public IReadOnlyList<PdfPage> AddTableOfContents(PdfTableOfContentsOptions? options = null)
    {
        options ??= PdfTableOfContentsOptions.Default;

        if (options.PageWidth <= 0 || options.PageHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Page dimensions must be greater than zero.");
        }

        if (options.TitleFontSize <= 0 || options.EntryFontSize <= 0 || options.EntryLineHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font sizes and line height must be greater than zero.");
        }

        if (options.MarginLeft < 0 || options.MarginRight < 0 || options.MarginTop < 0 || options.MarginBottom < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Margins cannot be negative.");
        }

        if (_bookmarks.Count == 0)
        {
            return Array.Empty<PdfPage>();
        }

        if (options.MarginLeft + options.MarginRight >= options.PageWidth)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Horizontal margins exceed TOC page width.");
        }

        if (options.MarginTop + options.MarginBottom >= options.PageHeight)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Vertical margins exceed TOC page height.");
        }

        var tocPages = new List<PdfPage>();
        var font = ResolveTableOfContentsFont(options);
        var textColor = options.TextColor ?? PdfColor.Black;
        var titleColor = options.TitleColor ?? textColor;
        var validBookmarks = _bookmarks
            .Where(bookmark => bookmark.PageNumber > 0 && bookmark.PageNumber <= _pages.Count)
            .ToList();

        if (validBookmarks.Count == 0)
        {
            return Array.Empty<PdfPage>();
        }

        var pageOffset = options.Placement == PdfTableOfContentsPlacement.Beginning
            ? CalculateTocPageCount(options, validBookmarks.Count)
            : 0;

        var currentPage = AddPage(options.PageWidth, options.PageHeight);
        tocPages.Add(currentPage);

        var currentY = currentPage.Height - options.MarginTop;
        var titleWidth = EstimateTextWidth(options.Title, options.TitleFontSize, font);
        var titleX = options.TitleAlignment switch
        {
            PdfTextAlignment.Left or PdfTextAlignment.Justify => options.MarginLeft,
            PdfTextAlignment.Center => options.MarginLeft + ((options.PageWidth - options.MarginLeft - options.MarginRight - titleWidth) / 2),
            PdfTextAlignment.Right => options.PageWidth - options.MarginRight - titleWidth,
            _ => options.MarginLeft
        };

        currentPage.DrawText(options.Title, titleX, currentY, new PdfDrawTextOptions
        {
            Font = font,
            FontSize = options.TitleFontSize,
            FillColor = titleColor
        });

        currentY -= options.TitleFontSize + options.TitleBottomSpacing;

        foreach (var bookmark in validBookmarks)
        {
            if (currentY - options.EntryFontSize < options.MarginBottom)
            {
                currentPage = AddPage(options.PageWidth, options.PageHeight);
                tocPages.Add(currentPage);
                currentY = currentPage.Height - options.MarginTop;
            }

            var destinationPage = bookmark.PageNumber + pageOffset;
            var pageNumberText = destinationPage.ToString();
            var pageNumberWidth = EstimateTextWidth(pageNumberText, options.EntryFontSize, font);
            var pageNumberX = currentPage.Width - options.MarginRight - pageNumberWidth;
            var entryTitleX = options.MarginLeft;
            var availableTitleWidth = pageNumberX - entryTitleX - 12;

            var displayTitle = FitTextToWidth(bookmark.Title, availableTitleWidth, options.EntryFontSize, font);

            currentPage.DrawText(displayTitle, entryTitleX, currentY, new PdfDrawTextOptions
            {
                Font = font,
                FontSize = options.EntryFontSize,
                FillColor = textColor
            });

            currentPage.DrawText(pageNumberText, pageNumberX, currentY, new PdfDrawTextOptions
            {
                Font = font,
                FontSize = options.EntryFontSize,
                FillColor = textColor
            });

            var linkWidth = currentPage.Width - options.MarginLeft - options.MarginRight;
            currentPage.AddPageLink(options.MarginLeft, currentY - 2, linkWidth, options.EntryLineHeight, destinationPage);

            currentY -= options.EntryLineHeight;
        }

        if (options.Placement == PdfTableOfContentsPlacement.Beginning)
        {
            foreach (var bookmark in _bookmarks)
            {
                bookmark.PageNumber += pageOffset;
            }

            _pages.RemoveAll(page => tocPages.Contains(page));
            _pages.InsertRange(0, tocPages);
        }

        foreach (var tocPage in tocPages)
        {
            _tableOfContentsPages.Add(tocPage);
        }

        return tocPages;
    }

    public PdfFlowContext CreateFlow(PdfFlowOptions? options = null)
    {
        options ??= PdfFlowOptions.Default;

        if (options.PageWidth <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "PageWidth must be greater than zero.");
        }

        if (options.PageHeight <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "PageHeight must be greater than zero.");
        }

        if (options.MarginLeft < 0 || options.MarginRight < 0 || options.MarginTop < 0 || options.MarginBottom < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Margins cannot be negative.");
        }

        if (options.MarginLeft + options.MarginRight >= options.PageWidth)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Horizontal margins exceed page width.");
        }

        if (options.MarginTop + options.MarginBottom >= options.PageHeight)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Vertical margins exceed page height.");
        }

        return new PdfFlowContext(this, options);
    }

    public void AddPageNumbers(PdfPageNumberOptions? options = null)
    {
        options ??= PdfPageNumberOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font size must be greater than zero.");
        }

        if (options.MarginX < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "MarginX cannot be negative.");
        }

        if (options.UseSectionNumbering && options.ShowTotalPages)
        {
            throw new ArgumentException("Section numbering cannot be combined with ShowTotalPages.", nameof(options));
        }

        if (_pages.Count == 0)
        {
            return;
        }

        ValidatePageNumberFilters(options);

        var filteredPageNumbers = GetFilteredPageNumbers(options);

        if (filteredPageNumbers.Count == 0)
        {
            return;
        }

        var endNumber = options.UseFilteredPageSequence
            ? options.StartNumber + filteredPageNumbers.Count - 1
            : options.StartNumber + _pages.Count - 1;

        var sectionStarts = options.UseSectionNumbering
            ? ResolveSectionStarts(filteredPageNumbers, options)
            : null;

        for (var index = 0; index < _pages.Count; index++)
        {
            var page = _pages[index];
            var pageNumber = index + 1;

            var filteredIndex = filteredPageNumbers.IndexOf(pageNumber);
            if (filteredIndex < 0)
            {
                continue;
            }

            var number = options.UseSectionNumbering
                ? ResolveSectionNumber(pageNumber, filteredPageNumbers, sectionStarts!, options)
                : options.UseFilteredPageSequence
                    ? options.StartNumber + filteredIndex
                    : options.StartNumber + index;
            var text = options.ShowTotalPages
                ? $"{options.Prefix}{number}{options.Separator}{endNumber}{options.Suffix}"
                : $"{options.Prefix}{number}{options.Suffix}";

            var font = ResolvePageNumberFont(page, options);
            var textWidth = EstimateTextWidth(text, options.FontSize, font);
            var x = ResolveAlignedX(page.Width, options.MarginX, textWidth, options.Alignment);

            page.DrawText(text, x, options.Y, new PdfDrawTextOptions
            {
                FontSize = options.FontSize,
                Font = font,
                FillColor = options.FillColor
            });
        }
    }

    private List<int> ResolveSectionStarts(List<int> filteredPages, PdfPageNumberOptions options)
    {
        if (options.SectionStartPages is { Count: > 0 })
        {
            foreach (var page in options.SectionStartPages)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "SectionStartPages values must be greater than zero.");
                }
            }
        }

        var configuredStarts = options.SectionStartPages is { Count: > 0 }
            ? options.SectionStartPages
            : _sections.Select(static section => section.StartPageNumber).ToList();

        var starts = configuredStarts
            .Where(filteredPages.Contains)
            .Distinct()
            .OrderBy(static page => page)
            .ToList();

        if (starts.Count == 0)
        {
            starts.Add(filteredPages[0]);
        }

        return starts;
    }

    private static int ResolveSectionNumber(int pageNumber, List<int> filteredPages, List<int> sectionStarts, PdfPageNumberOptions options)
    {
        var sectionStart = sectionStarts[0];

        for (var i = 1; i < sectionStarts.Count; i++)
        {
            if (sectionStarts[i] <= pageNumber)
            {
                sectionStart = sectionStarts[i];
            }
            else
            {
                break;
            }
        }

        var sectionStartIndex = filteredPages.IndexOf(sectionStart);
        var pageIndex = filteredPages.IndexOf(pageNumber);

        if (sectionStartIndex < 0 || pageIndex < 0)
        {
            return options.StartNumber;
        }

        return options.StartNumber + (pageIndex - sectionStartIndex);
    }

    public void AddTextWatermark(string text, PdfWatermarkOptions? options = null)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            throw new ArgumentException("Watermark text cannot be null or empty.", nameof(text));
        }

        options ??= PdfWatermarkOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "FontSize must be greater than zero.");
        }

        if (_pages.Count == 0)
        {
            return;
        }

        ValidateWatermarkPageFilters(options);

        for (var i = 0; i < _pages.Count; i++)
        {
            var page = _pages[i];
            var pageNumber = i + 1;

            if (!ShouldRenderWatermarkForPage(page, pageNumber, options))
            {
                continue;
            }

            var font = ResolveWatermarkFont(page, options);
            var textWidth = EstimateTextWidth(text, options.FontSize, font);
            var x = ((page.Width - textWidth) / 2) + options.OffsetX;
            var y = (page.Height / 2) + options.OffsetY;

            page.DrawText(text, x, y, new PdfDrawTextOptions
            {
                FontSize = options.FontSize,
                Font = font,
                FillColor = options.FillColor,
                RotationDegrees = options.RotationDegrees
            });
        }
    }

    public void AddHeadersAndFooters(PdfHeaderFooterOptions? options = null)
    {
        options ??= PdfHeaderFooterOptions.Default;

        if (options.FontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "Font size must be greater than zero.");
        }

        if (options.MarginX < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "MarginX cannot be negative.");
        }

        if (options.HeaderTopMargin < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "HeaderTopMargin cannot be negative.");
        }

        if (options.FooterY < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "FooterY cannot be negative.");
        }

        if (_pages.Count == 0)
        {
            return;
        }

        ValidateHeaderFooterPageFilters(options);

        var filteredPageNumbers = GetFilteredHeaderFooterPages(options);

        if (filteredPageNumbers.Count == 0)
        {
            return;
        }

        var endNumber = options.UseFilteredPageSequence
            ? options.StartNumber + filteredPageNumbers.Count - 1
            : options.StartNumber + _pages.Count - 1;

        for (var index = 0; index < _pages.Count; index++)
        {
            var page = _pages[index];
            var pageNumber = index + 1;

            var filteredIndex = filteredPageNumbers.IndexOf(pageNumber);

            if (filteredIndex < 0)
            {
                continue;
            }

            var number = options.UseFilteredPageSequence
                ? options.StartNumber + filteredIndex
                : options.StartNumber + index;
            var font = ResolveHeaderFooterFont(page, options);

            var currentSectionName = ResolveSectionName(pageNumber);
            var currentSectionPage = ResolveSectionPageNumber(pageNumber);
            var currentSectionTotal = ResolveSectionTotalPages(pageNumber);
            var currentSectionIndex = ResolveSectionIndex(pageNumber);
            var totalSections = Math.Max(1, _sections.Count);

            if (!string.IsNullOrWhiteSpace(options.HeaderTemplate))
            {
                var headerText = ResolveTemplate(this, options.HeaderTemplate, number, endNumber, currentSectionName, currentSectionPage, currentSectionTotal, currentSectionIndex, totalSections, options.SuppressEmptySectionTokens);
                DrawHeaderOrFooterLines(
                    page,
                    headerText,
                    font,
                    options.FontSize,
                    options.MarginX,
                    options.HeaderAlignment,
                    page.Height - options.HeaderTopMargin,
                    options.HeaderLineSpacing ?? options.FontSize * 1.2,
                    options.FillColor,
                    header: true);
            }

            if (!string.IsNullOrWhiteSpace(options.FooterTemplate))
            {
                var footerText = ResolveTemplate(this, options.FooterTemplate, number, endNumber, currentSectionName, currentSectionPage, currentSectionTotal, currentSectionIndex, totalSections, options.SuppressEmptySectionTokens);
                DrawHeaderOrFooterLines(
                    page,
                    footerText,
                    font,
                    options.FontSize,
                    options.MarginX,
                    options.FooterAlignment,
                    options.FooterY,
                    options.FooterLineSpacing ?? options.FontSize * 1.2,
                    options.FillColor,
                    header: false);
            }
        }
    }

    public void Save(string filePath)
    {
        Save(filePath, PdfSaveOptions.Default);
    }

    public void Save(string filePath, PdfSaveOptions options)
    {
        ArgumentNullException.ThrowIfNull(options);

        File.WriteAllBytes(filePath, ToBytes(options));
    }

    public void Save(Stream stream, PdfSaveOptions? options = null)
    {
        ArgumentNullException.ThrowIfNull(stream);

        if (!stream.CanWrite)
        {
            throw new ArgumentException("Target stream must be writable.", nameof(stream));
        }

        var bytes = ToBytes(options);
        stream.Write(bytes, 0, bytes.Length);
    }

    public byte[] ToBytes(PdfSaveOptions? options = null)
    {
        options ??= PdfSaveOptions.Default;
        var writer = new PdfWriter();
        var result = writer.Write(this, options);

        _lastDiagnostics = options.CollectDiagnostics
            ? result.Diagnostics
            : null;

        return result.Bytes;
    }

    private static double ResolveAlignedX(double pageWidth, double marginX, double textWidth, PdfTextAlignment alignment)
    {
        var x = alignment switch
        {
            PdfTextAlignment.Left or PdfTextAlignment.Justify => marginX,
            PdfTextAlignment.Center => (pageWidth - textWidth) / 2,
            PdfTextAlignment.Right => pageWidth - marginX - textWidth,
            _ => throw new ArgumentOutOfRangeException(nameof(alignment), "Unsupported text alignment.")
        };

        return x < 0 ? 0 : x;
    }

    private static PdfStandardFont ResolvePageNumberFont(PdfPage page, PdfPageNumberOptions options)
    {
        return options.Font
            ?? (options.FontFamily is { } family
                ? PdfStandardFonts.FromStyle(family, options.Bold, options.Italic)
                : page.DefaultFont);
    }

    private static void ValidateWatermarkPageFilters(PdfWatermarkOptions options)
    {
        if (options.StartPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber must be greater than zero when provided.");
        }

        if (options.EndPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "EndPageNumber must be greater than zero when provided.");
        }

        if (options.StartPageNumber is { } start && options.EndPageNumber is { } end && start > end)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber cannot be greater than EndPageNumber.");
        }

        if (options.IncludePageNumbers is { } includes)
        {
            foreach (var page in includes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "IncludePageNumbers values must be greater than zero.");
                }
            }
        }

        if (options.ExcludePageNumbers is { } excludes)
        {
            foreach (var page in excludes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "ExcludePageNumbers values must be greater than zero.");
                }
            }
        }
    }

    private bool ShouldRenderWatermarkForPage(PdfPage page, int pageNumber, PdfWatermarkOptions options)
    {
        if (options.SkipFirstPage && pageNumber == 1)
        {
            return false;
        }

        if (options.SkipLastPage && pageNumber == _pages.Count)
        {
            return false;
        }

        if (options.ExcludeTableOfContentsPages && _tableOfContentsPages.Contains(page))
        {
            return false;
        }

        if (options.StartPageNumber is { } start && pageNumber < start)
        {
            return false;
        }

        if (options.EndPageNumber is { } end && pageNumber > end)
        {
            return false;
        }

        if (options.IncludePageNumbers is { Count: > 0 } includes && !includes.Contains(pageNumber))
        {
            return false;
        }

        if (options.ExcludePageNumbers is { Count: > 0 } excludes && excludes.Contains(pageNumber))
        {
            return false;
        }

        return true;
    }

    private static void ValidatePageNumberFilters(PdfPageNumberOptions options)
    {
        if (options.StartPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber must be greater than zero when provided.");
        }

        if (options.EndPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "EndPageNumber must be greater than zero when provided.");
        }

        if (options.StartPageNumber is { } start && options.EndPageNumber is { } end && start > end)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber cannot be greater than EndPageNumber.");
        }

        if (options.IncludePageNumbers is { } includes)
        {
            foreach (var page in includes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "IncludePageNumbers values must be greater than zero.");
                }
            }
        }

        if (options.ExcludePageNumbers is { } excludes)
        {
            foreach (var page in excludes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "ExcludePageNumbers values must be greater than zero.");
                }
            }
        }
    }

    private bool ShouldRenderPageNumber(PdfPage page, int pageNumber, PdfPageNumberOptions options)
    {
        if (options.SkipFirstPage && pageNumber == 1)
        {
            return false;
        }

        if (options.SkipLastPage && pageNumber == _pages.Count)
        {
            return false;
        }

        if (options.ExcludeTableOfContentsPages && _tableOfContentsPages.Contains(page))
        {
            return false;
        }

        if (options.StartPageNumber is { } start && pageNumber < start)
        {
            return false;
        }

        if (options.EndPageNumber is { } end && pageNumber > end)
        {
            return false;
        }

        if (options.IncludePageNumbers is { Count: > 0 } includes && !includes.Contains(pageNumber))
        {
            return false;
        }

        if (options.ExcludePageNumbers is { Count: > 0 } excludes && excludes.Contains(pageNumber))
        {
            return false;
        }

        return true;
    }

    private List<int> GetFilteredHeaderFooterPages(PdfHeaderFooterOptions options)
    {
        var pages = new List<int>();

        for (var i = 0; i < _pages.Count; i++)
        {
            var pageNumber = i + 1;
            if (ShouldRenderForPage(_pages[i], pageNumber, options))
            {
                pages.Add(pageNumber);
            }
        }

        return pages;
    }

    private List<int> GetFilteredPageNumbers(PdfPageNumberOptions options)
    {
        var pages = new List<int>();

        for (var i = 0; i < _pages.Count; i++)
        {
            var pageNumber = i + 1;
            if (ShouldRenderPageNumber(_pages[i], pageNumber, options))
            {
                pages.Add(pageNumber);
            }
        }

        return pages;
    }

    private static void ValidateHeaderFooterPageFilters(PdfHeaderFooterOptions options)
    {
        if (options.StartPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber must be greater than zero when provided.");
        }

        if (options.EndPageNumber is <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "EndPageNumber must be greater than zero when provided.");
        }

        if (options.StartPageNumber is { } start && options.EndPageNumber is { } end && start > end)
        {
            throw new ArgumentOutOfRangeException(nameof(options), "StartPageNumber cannot be greater than EndPageNumber.");
        }

        if (options.IncludePageNumbers is { } includes)
        {
            foreach (var page in includes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "IncludePageNumbers values must be greater than zero.");
                }
            }
        }

        if (options.ExcludePageNumbers is { } excludes)
        {
            foreach (var page in excludes)
            {
                if (page <= 0)
                {
                    throw new ArgumentOutOfRangeException(nameof(options), "ExcludePageNumbers values must be greater than zero.");
                }
            }
        }
    }

    private bool ShouldRenderForPage(PdfPage page, int pageNumber, PdfHeaderFooterOptions options)
    {
        if (options.SkipFirstPage && pageNumber == 1)
        {
            return false;
        }

        if (options.SkipLastPage && pageNumber == _pages.Count)
        {
            return false;
        }

        if (options.ExcludeTableOfContentsPages && _tableOfContentsPages.Contains(page))
        {
            return false;
        }

        if (options.StartPageNumber is { } start && pageNumber < start)
        {
            return false;
        }

        if (options.EndPageNumber is { } end && pageNumber > end)
        {
            return false;
        }

        if (options.IncludePageNumbers is { Count: > 0 } includes && !includes.Contains(pageNumber))
        {
            return false;
        }

        if (options.ExcludePageNumbers is { Count: > 0 } excludes && excludes.Contains(pageNumber))
        {
            return false;
        }

        return true;
    }

