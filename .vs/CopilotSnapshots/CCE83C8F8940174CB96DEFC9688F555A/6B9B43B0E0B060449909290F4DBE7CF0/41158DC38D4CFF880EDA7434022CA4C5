using Canvas.Pdf;

var document = new PdfDocument();
var firstPage = document.AddPage();
var secondPage = document.AddPage();

firstPage.DrawText("Hello World from a minimal PDF engine", x: 100, y: 700, fontSize: 18, font: PdfStandardFont.Helvetica);
firstPage.DrawText("This PDF was generated without external PDF libraries.", x: 100, y: 670, fontSize: 12, font: PdfStandardFont.TimesRoman);

secondPage.DrawText("Second page", x: 100, y: 700, fontSize: 16, font: PdfStandardFont.Courier);
secondPage.DrawText("Multi-page + font selection API demo", x: 100, y: 670, fontSize: 12, font: PdfStandardFont.Helvetica);

var outputPath = Path.Combine(AppContext.BaseDirectory, "output.pdf");
document.Save(outputPath);

Console.WriteLine($"PDF generated at: {outputPath}");
