using Canvas.Pdf.Layout;

namespace Canvas.Pdf;

public sealed class PdfPage
{
    private readonly List<TextElement> _elements = new();

    internal PdfPage(double width, double height)
    {
        Width = width;
        Height = height;
    }

    public double Width { get; }

    public double Height { get; }

    internal IReadOnlyList<TextElement> Elements => _elements;

    public void DrawText(string text, double x, double y, double fontSize = 12, PdfStandardFont font = PdfStandardFont.Helvetica)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            throw new ArgumentException("Text cannot be null or empty.", nameof(text));
        }

        if (fontSize <= 0)
        {
            throw new ArgumentOutOfRangeException(nameof(fontSize), "Font size must be greater than zero.");
        }

        _elements.Add(new TextElement(text, x, y, fontSize, font));
    }
}
