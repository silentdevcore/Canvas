using Canvas.Application.UseCases;
using Canvas.Infrastructure.Pdf;
using Canvas.Pdf;

var facade = new PdfFacade();
var document = new PdfDocument();
var page = document.AddPage();
page.DrawText("Canvas façade demo", x: 100, y: 700, fontSize: 14);

facade.ApplyPageNumbering(document);
facade.GenerateToFile(document, "demo-facade-output.pdf");

Console.WriteLine("Canvas.Demo generated demo-facade-output.pdf using Canvas.Infrastructure.Pdf.PdfFacade.");
