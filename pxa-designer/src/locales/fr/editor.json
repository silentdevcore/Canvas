    "quickSteps": {
      "1": {
        "title": "Ouvrir un modèle",
        "desc": "Parcourez la galerie de modèles et cliquez sur « Utiliser ce modèle » pour commencer."
      },
      "2": {
        "title": "Ajouter des éléments",
        "desc": "Cliquez sur un outil dans la barre d'outils de gauche pour le placer dans la zone de travail, ou faites-le glisser à un endroit précis."
      },
      "3": {
        "title": "Modifier les propriétés",
        "desc": "Sélectionnez un élément et ajustez son contenu, son style et sa disposition dans le panneau d'inspection à droite."
      },
      "4": {
        "title": "Aperçu de votre document",
        "desc": "Cliquez sur « Aperçu » dans la barre supérieure pour voir un rendu en direct de votre modèle avec des exemples de données."
      },
      "5": {
        "title": "Exporter",
        "desc": "Cliquez sur l'icône d'exportation pour télécharger en PDF, Word, JSON, image ou autres formats."
      }
    },
