    "faq": {
      "exportPdf": {
        "q": "Comment exporter un PDF ?",
        "a": "Cliquez sur l'icône d'exportation (⬆) dans la barre supérieure, sélectionnez « PDF » dans la liste des formats, puis cliquez sur Télécharger."
      },
      "backgroundImage": {
        "q": "Comment ajouter une image de fond ?",
        "a": "Cliquez sur l'icône des paramètres de page (⚙) lorsque rien n'est sélectionné, puis définissez « Image de fond » dans l'inspecteur."
      },
      "templateVariables": {
        "q": "Comment utiliser les variables de modèle ?",
        "a": "Tapez {{VARIABLE_NAME}} dans n'importe quel élément de texte. Les variables sont remplies au moment du rendu à partir de vos données JSON."
      },
      "secondPage": {
        "q": "Comment ajouter une deuxième page ?",
        "a": "Cliquez sur le bouton + dans la bande de pages en bas de la zone de travail."
      },
      "multiLanguage": {
        "q": "Comment configurer le multilingue ?",
        "a": "Dans les paramètres de page, ajoutez des langues dans la section « Langues ». Un onglet par langue apparaît au-dessus de la zone de travail."
      },
      "drawLine": {
        "q": "Comment dessiner une ligne ou une flèche ?",
        "a": "Cliquez sur l'outil Ligne, Flèche ou Dessin dans la barre d'outils — un indicateur bleu apparaît. Faites ensuite glisser dans la zone de travail pour placer l'élément."
      },
      "tableOfContents": {
        "q": "Comment générer une table des matières ?",
        "a": "Ajoutez un élément « Table des matières », puis définissez le niveau de titre sur vos éléments de texte. Cliquez sur « Mettre à jour la table des matières » dans l'inspecteur."
      },
      "addressForm": {
        "q": "Comment insérer un formulaire d'adresse ?",
        "a": "Cliquez sur « Insérer un bloc de formulaire » en bas de la barre d'outils de gauche et choisissez Bloc d'adresse."
      }
    }
  },
