    "faq": {
      "exportPdf": {
        "q": "Wie exportiere ich ein PDF?",
        "a": "Klicken Sie auf das Export-Symbol (⬆) in der oberen Leiste, wählen Sie „PDF“ aus der Formatliste und klicken Sie dann auf Herunterladen."
      },
      "backgroundImage": {
        "q": "Wie füge ich ein Hintergrundbild hinzu?",
        "a": "Klicken Sie auf das Seiteneinstellungssymbol (⚙), wenn nichts ausgewählt ist, und legen Sie dann „Hintergrundbild“ im Inspektor fest."
      },
      "templateVariables": {
        "q": "Wie verwende ich Vorlagenvariablen?",
        "a": "Geben Sie {{VARIABLE_NAME}} in ein beliebiges Textelement ein. Variablen werden zur Renderzeit aus Ihren JSON-Daten gefüllt."
      },
      "secondPage": {
        "q": "Wie füge ich eine zweite Seite hinzu?",
        "a": "Klicken Sie auf die Schaltfläche + im Seitenstreifen am unteren Rand der Zeichenfläche."
      },
      "multiLanguage": {
        "q": "Wie richte ich Mehrsprachigkeit ein?",
        "a": "Fügen Sie in den Seiteneinstellungen Sprachen im Abschnitt „Sprachen“ hinzu. Über der Zeichenfläche erscheint ein Tab pro Sprache."
      },
      "drawLine": {
        "q": "Wie zeichne ich eine Linie oder einen Pfeil?",
        "a": "Klicken Sie auf das Werkzeug Linie, Pfeil oder Zeichnen in der Werkzeugleiste — eine blaue Markierung erscheint. Ziehen Sie dann auf der Zeichenfläche, um das Element zu platzieren."
      },
      "tableOfContents": {
        "q": "Wie erstelle ich ein Inhaltsverzeichnis?",
        "a": "Fügen Sie ein „Inhaltsverzeichnis“-Element hinzu und legen Sie dann die Überschriftenebene für Ihre Textelemente fest. Klicken Sie im Inspektor auf „Inhaltsverzeichnis aktualisieren“."
      },
      "addressForm": {
        "q": "Wie füge ich ein Adressformular ein?",
        "a": "Klicken Sie unten in der linken Werkzeugleiste auf „Formularblock einfügen“ und wählen Sie Adressblock."
      }
    }
  },
