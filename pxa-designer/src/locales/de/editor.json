    "quickSteps": {
      "1": {
        "title": "Eine Vorlage öffnen",
        "desc": "Durchsuchen Sie die Vorlagengalerie und klicken Sie auf „Diese Vorlage verwenden“, um zu starten."
      },
      "2": {
        "title": "Elemente hinzufügen",
        "desc": "Klicken Sie auf ein Werkzeug in der linken Werkzeugleiste, um es auf der Zeichenfläche zu platzieren, oder ziehen Sie es an eine bestimmte Position."
      },
      "3": {
        "title": "Eigenschaften bearbeiten",
        "desc": "Wählen Sie ein Element aus und passen Sie Inhalt, Stil und Layout im rechten Inspektorbereich an."
      },
      "4": {
        "title": "Dokument-Vorschau",
        "desc": "Klicken Sie in der oberen Leiste auf „Vorschau“, um eine Live-Darstellung Ihrer Vorlage mit Beispieldaten zu sehen."
      },
      "5": {
        "title": "Exportieren",
        "desc": "Klicken Sie auf das Export-Symbol, um als PDF, Word, JSON, Bild oder andere Formate herunterzuladen."
      }
    },
