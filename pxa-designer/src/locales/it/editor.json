    "quickSteps": {
      "1": {
        "title": "Apri un modello",
        "desc": "Sfoglia la galleria dei modelli e fai clic su \"Usa questo modello\" per iniziare."
      },
      "2": {
        "title": "Aggiungi elementi",
        "desc": "Fai clic su uno strumento nella barra degli strumenti a sinistra per posizionarlo sulla tela, oppure trascinalo in una posizione specifica."
      },
      "3": {
        "title": "Modifica le proprietà",
        "desc": "Seleziona un elemento e regola il suo contenuto, stile e layout nel pannello dell'ispettore a destra."
      },
      "4": {
        "title": "Anteprima del documento",
        "desc": "Fai clic su \"Anteprima\" nella barra superiore per vedere un rendering dal vivo del tuo modello con dati di esempio."
      },
      "5": {
        "title": "Esporta",
        "desc": "Fai clic sull'icona di esportazione per scaricare come PDF, Word, JSON, immagine o altri formati."
      }
    },
