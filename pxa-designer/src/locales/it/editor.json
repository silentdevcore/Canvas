    "faq": {
      "exportPdf": {
        "q": "Come esporto un PDF?",
        "a": "Fai clic sull'icona di esportazione (⬆) nella barra superiore, seleziona \"PDF\" dall'elenco dei formati, quindi fai clic su Scarica."
      },
      "backgroundImage": {
        "q": "Come aggiungo un'immagine di sfondo?",
        "a": "Fai clic sull'icona delle impostazioni pagina (⚙) quando nulla è selezionato, quindi imposta \"Immagine di sfondo\" nell'ispettore."
      },
      "templateVariables": {
        "q": "Come uso le variabili del modello?",
        "a": "Digita {{VARIABLE_NAME}} in qualsiasi elemento di testo. Le variabili vengono compilate al momento del rendering dai tuoi dati JSON."
      },
      "secondPage": {
        "q": "Come aggiungo una seconda pagina?",
        "a": "Fai clic sul pulsante + nella striscia delle pagine in fondo all'area della tela."
      },
      "multiLanguage": {
        "q": "Come imposto il multilingua?",
        "a": "In Impostazioni pagina, aggiungi lingue nella sezione \"Lingue\". Sopra la tela appare una scheda per lingua."
      },
      "drawLine": {
        "q": "Come disegno una linea o una freccia?",
        "a": "Fai clic sullo strumento Linea, Freccia o Disegna nella barra degli strumenti — appare un badge blu. Quindi trascina sulla tela per posizionare l'elemento."
      },
      "tableOfContents": {
        "q": "Come genero un sommario?",
        "a": "Aggiungi un elemento \"Sommario\", quindi imposta il livello di intestazione sui tuoi elementi di testo. Fai clic su \"Aggiorna sommario\" nell'ispettore."
      },
      "addressForm": {
        "q": "Come inserisco un modulo di indirizzo?",
        "a": "Fai clic su \"Inserisci blocco modulo\" in fondo alla barra degli strumenti a sinistra e scegli Blocco indirizzo."
      }
    }
  },
