    "quickSteps": {
      "1": {
        "title": "Abrir una plantilla",
        "desc": "Explora la galería de plantillas y haz clic en «Usar esta plantilla» para comenzar."
      },
      "2": {
        "title": "Añadir elementos",
        "desc": "Haz clic en cualquier herramienta de la barra izquierda para colocarla en el lienzo, o arrástrala a una posición específica."
      },
      "3": {
        "title": "Editar propiedades",
        "desc": "Selecciona un elemento y ajusta su contenido, estilo y diseño en el panel de inspección derecho."
      },
      "4": {
        "title": "Vista previa de tu documento",
        "desc": "Haz clic en «Vista previa» en la barra superior para ver una representación en vivo de tu plantilla con datos de ejemplo."
      },
      "5": {
        "title": "Exportar",
        "desc": "Haz clic en el icono de exportación para descargar como PDF, Word, JSON, imagen u otros formatos."
      }
    },
    "shortcuts": {
      "undo": "Deshacer",
