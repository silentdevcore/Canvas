      "deselect": "Deseleccionar / cancelar dibujo",
      "openHelp": "Abrir este cuadro de diálogo de ayuda"
    },
    "faq": {
      "exportPdf": {
        "q": "¿Cómo exporto un PDF?",
        "a": "Haz clic en el icono de exportación (⬆) en la barra superior, selecciona «PDF» en la lista de formatos y luego haz clic en Descargar."
      },
      "backgroundImage": {
        "q": "¿Cómo añado una imagen de fondo?",
        "a": "Haz clic en el icono de configuración de página (⚙) cuando no haya nada seleccionado, y luego establece «Imagen de fondo» en el inspector."
      },
      "templateVariables": {
        "q": "¿Cómo uso variables de plantilla?",
        "a": "Escribe {{VARIABLE_NAME}} dentro de cualquier elemento de texto. Las variables se rellenan en el momento de renderizar a partir de tus datos JSON."
      },
      "secondPage": {
        "q": "¿Cómo añado una segunda página?",
        "a": "Haz clic en el botón + en la franja de páginas en la parte inferior del área del lienzo."
      },
      "multiLanguage": {
        "q": "¿Cómo configuro varios idiomas?",
        "a": "En Configuración de página, añade idiomas en la sección «Idiomas». Aparecerá una pestaña por idioma encima del lienzo."
      },
      "drawLine": {
        "q": "¿Cómo dibujo una línea o flecha?",
        "a": "Haz clic en la herramienta Línea, Flecha o Dibujo en la barra de herramientas — aparecerá una insignia azul. Luego arrastra en el lienzo para colocar el elemento."
      },
      "tableOfContents": {
        "q": "¿Cómo genero una tabla de contenido?",
        "a": "Añade un elemento «Tabla de contenido» y luego establece el nivel de encabezado en tus elementos de texto. Haz clic en «Actualizar TOC» en el inspector."
      },
      "addressForm": {
        "q": "¿Cómo inserto un formulario de dirección?",
        "a": "Haz clic en «Insertar bloque de formulario» en la parte inferior de la barra de herramientas izquierda y elige Bloque de dirección."
      }
    }
  },
