    "quickSteps": {
      "1": {
        "title": "Open a template",
        "desc": "Browse the template gallery and click \"Use this template\" to start."
      },
      "2": {
        "title": "Add elements",
        "desc": "Click any tool in the left toolbar to place it on the canvas, or drag it to a specific position."
      },
      "3": {
        "title": "Edit properties",
        "desc": "Select an element and adjust its content, style, and layout in the right inspector panel."
      },
      "4": {
        "title": "Preview your document",
        "desc": "Click \"Preview\" in the top bar to see a live render of your template with sample data."
      },
      "5": {
        "title": "Export",
        "desc": "Click the export icon to download as PDF, Word, JSON, image, or other formats."
      }
    },
    "shortcuts": {
      "undo": "Undo",
      "redo": "Redo",
      "selectAll": "Select all elements",
      "copy": "Copy selected element",
      "paste": "Paste element",
      "duplicate": "Duplicate element",
      "delete": "Delete selected element",
      "moveOnePx": "Move element 1 px",
      "moveTenPx": "Move element 10 px",
      "zoomIn": "Zoom in",
      "zoomOut": "Zoom out",
      "zoomReset": "Reset zoom to 100 %",
      "deselect": "Deselect / cancel drawing",
      "openHelp": "Open this help dialog"
    },
    "faq": {
      "exportPdf": {
        "q": "How do I export a PDF?",
        "a": "Click the export icon (⬆) in the top bar, select \"PDF\" from the format list, then click Download."
      },
      "backgroundImage": {
        "q": "How do I add a background image?",
        "a": "Click the page settings icon (⚙) when nothing is selected, then set \"Background Image\" in the inspector."
      },
      "templateVariables": {
        "q": "How do I use template variables?",
        "a": "Type {{VARIABLE_NAME}} inside any text element. Variables are filled at render time from your JSON data."
      },
      "secondPage": {
        "q": "How do I add a second page?",
        "a": "Click the + button in the page strip at the bottom of the canvas area."
      },
      "multiLanguage": {
        "q": "How do I set up multi-language?",
        "a": "In Page Settings, add languages under the \"Languages\" section. A tab per language appears above the canvas."
      },
      "drawLine": {
        "q": "How do I draw a line or arrow?",
        "a": "Click the Line, Arrow, or Draw tool in the toolbar — a blue badge appears. Then drag on the canvas to place the element."
      },
      "tableOfContents": {
        "q": "How do I generate a Table of Contents?",
        "a": "Add a \"Table of Contents\" element, then set Heading Level on your text elements. Click \"Update TOC\" in the inspector."
      },
      "addressForm": {
        "q": "How do I insert an address form?",
        "a": "Click \"Insert Form Block\" at the bottom of the left toolbar and choose Address Block."
      }
    }
  },
