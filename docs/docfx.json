{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/Core/PXA.Core/PXA.Core.csproj",
            "src/Generation/PXA.Pdf/PXA.Pdf.csproj",
            "src/Generation/PXA.Generator/PXA.Generator.csproj",
            "src/Importing/PXA.Importer/PXA.Importer.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["index.md", "csharp-cookbook.md", "charts.md", "code-designer-workspace.md", "guides/**.md", "toc.yml"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "PXA PDF",
      "_appTitle": "PXA PDF API Reference",
      "_enableSearch": true
    }
  }
}
