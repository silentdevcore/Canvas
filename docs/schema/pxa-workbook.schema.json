{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxa/schema/pxa-workbook.schema.json",
  "title": "PXA Workbook JSON",
  "description": "The canonical PXA spreadsheet workbook format (camelCase). POST to /api/spreadsheet/export (→ .xlsx/.xls/.csv/.tsv), /calculate, /render, /sort, /find-replace, /fill. Round-trips to .xlsx via ClosedXML. Mirrors src/Canvas.Core/Contracts/SpreadsheetDto.cs.",
  "type": "object",
  "required": ["id", "name", "sheets"],
  "properties": {
    "$schema": { "type": "string", "description": "Optional JSON Schema URL for tooling validation." },
    "schemaVersion": { "type": "string", "description": "PXA Workbook JSON format version, e.g. \"1.0\". Defaults to \"1.0\" when absent." },
    "id": { "type": "string", "description": "Unique workbook id." },
    "name": { "type": "string", "description": "Human-readable workbook name." },
    "sheets": { "type": "array", "description": "Worksheets, in order.", "items": { "$ref": "#/$defs/sheet" } },
    "definedNames": { "type": "array", "description": "Named ranges.", "items": { "$ref": "#/$defs/definedName" } }
  },
  "additionalProperties": true,
  "$defs": {
    "sheet": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rowCount": { "type": "integer", "description": "Logical grid extent (cells are sparse)." },
        "colCount": { "type": "integer" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "cells": { "type": "array", "description": "Sparse — only non-empty/styled cells.", "items": { "$ref": "#/$defs/cell" } },
        "merges": { "type": "array", "description": "Merged ranges in A1 notation, e.g. \"A1:B2\".", "items": { "type": "string" } },
        "frozenRows": { "type": "integer" },
        "frozenCols": { "type": "integer" },
        "autoFilterRange": { "type": "string", "description": "A1 range the auto-filter covers." },
        "pageSetup": { "$ref": "#/$defs/pageSetup" },
        "protection": { "$ref": "#/$defs/protection" },
        "conditionalFormats": { "type": "array", "items": { "$ref": "#/$defs/conditionalFormat" } },
        "dataValidations": { "type": "array", "items": { "$ref": "#/$defs/dataValidation" } }
      },
      "additionalProperties": true
    },
    "cell": {
      "type": "object",
      "required": ["row", "col", "type"],
      "properties": {
        "row": { "type": "integer", "description": "0-based row." },
        "col": { "type": "integer", "description": "0-based column." },
        "type": { "type": "string", "enum": ["number", "text", "boolean", "date", "formula", "empty"] },
        "value": { "description": "Literal value, or a formula cell's last computed value." },
        "formula": { "type": "string", "description": "A1 formula starting with '=', e.g. \"=SUM(A1:A10)\"." },
        "numberFormat": { "type": "string", "description": "Excel number-format code, e.g. \"#,##0.00\"." },
        "style": { "$ref": "#/$defs/cellStyle" },
        "comment": { "type": "string" },
        "hyperlink": { "type": "string", "description": "URL or internal \"Sheet!A1\"." }
      },
      "additionalProperties": true
    },
    "cellStyle": {
      "type": "object",
      "properties": {
        "backgroundColor": { "type": "string" },
        "color": { "type": "string" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "textAlign": { "type": "string", "enum": ["left", "center", "right"] },
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number" }
      },
      "additionalProperties": true
    },
    "column": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "description": "0-based column index." },
        "width": { "type": "number", "description": "Excel character units." },
        "hidden": { "type": "boolean" },
        "outlineLevel": { "type": "integer", "description": "Grouping level (0 = none)." }
      },
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "description": "0-based row index." },
        "height": { "type": "number", "description": "Points." },
        "hidden": { "type": "boolean" },
        "outlineLevel": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "pageSetup": {
      "type": "object",
      "properties": {
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "paperSize": { "type": "string", "description": "e.g. \"A4\", \"Letter\"." },
        "printArea": { "type": "string" },
        "header": { "type": "string" },
        "footer": { "type": "string" },
        "fitToWidth": { "type": "integer" },
        "fitToHeight": { "type": "integer" },
        "scale": { "type": "number" },
        "margins": { "$ref": "#/$defs/margins" },
        "rowPageBreaks": { "type": "array", "items": { "type": "integer" } },
        "colPageBreaks": { "type": "array", "items": { "type": "integer" } }
      },
      "additionalProperties": true
    },
    "margins": {
      "type": "object",
      "properties": {
        "top": { "type": "number" }, "right": { "type": "number" },
        "bottom": { "type": "number" }, "left": { "type": "number" }
      },
      "additionalProperties": true
    },
    "protection": {
      "type": "object",
      "required": ["protected"],
      "properties": {
        "protected": { "type": "boolean" },
        "password": { "type": "string" }
      },
      "additionalProperties": true
    },
    "conditionalFormat": {
      "type": "object",
      "required": ["range", "type"],
      "properties": {
        "range": { "type": "string" },
        "type": { "type": "string", "enum": ["cellIs", "colorScale", "dataBar"] },
        "operator": { "type": "string" },
        "value": { "type": "string" },
        "value2": { "type": "string" },
        "color": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dataValidation": {
      "type": "object",
      "required": ["range", "type"],
      "properties": {
        "range": { "type": "string" },
        "type": { "type": "string", "enum": ["list", "wholeNumber", "decimal", "date", "textLength"] },
        "operator": { "type": "string" },
        "value1": { "type": "string" },
        "value2": { "type": "string" },
        "listSource": { "type": "string" }
      },
      "additionalProperties": true
    },
    "definedName": {
      "type": "object",
      "required": ["name", "refersTo"],
      "properties": {
        "name": { "type": "string" },
        "refersTo": { "type": "string", "description": "e.g. \"Sheet1!$A$1:$A$10\"." }
      },
      "additionalProperties": true
    }
  }
}
