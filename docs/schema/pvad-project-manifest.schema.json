{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvade.com/schemas/pvad-project-manifest.schema.json",
  "title": "PVAD Native Project Manifest",
  "description": "Manifest shared by PVADP PDF (.pvadp) and PVADS Spreadsheet (.pvads) projects.",
  "type": "object",
  "required": [
    "magic",
    "formatId",
    "mediaType",
    "envelopeVersion",
    "documentSchemaVersion",
    "minimumPvadVersion",
    "documentId",
    "title",
    "createdAtUtc",
    "modifiedAtUtc",
    "locale",
    "entryDocument",
    "contentHash",
    "assets",
    "entryChecksums"
  ],
  "properties": {
    "magic": {
      "enum": [
        "PVAD-PVADP-1",
        "PVAD-PVADS-1"
      ]
    },
    "formatId": {
      "enum": [
        "pvadp",
        "pvads"
      ]
    },
    "mediaType": {
      "enum": [
        "application/vnd.pvad.pvadp+zip",
        "application/vnd.pvad.pvads+zip"
      ]
    },
    "envelopeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "documentSchemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "minimumPvadVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "modifiedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35
    },
    "entryDocument": {
      "const": "document.json"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    },
    "assets": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "components": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "entryChecksums": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(mimetype|document\\.json|components/code-workspace\\.json|assets/(images|fonts|previews|sources|data)/[A-Za-z0-9._-]+\\.(png|jpg|gif|webp|svg|ttf|otf|woff|woff2|pdf|json))$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "requiredFeatures": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "fileName",
        "contentType",
        "length",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "kind": {
          "enum": [
            "image",
            "font",
            "preview",
            "source",
            "data"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assets/(images|fonts|previews|sources|data)/[A-Za-z0-9._-]+\\.(png|jpg|gif|webp|svg|ttf|otf|woff|woff2|pdf|json)$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/svg+xml",
            "font/ttf",
            "font/otf",
            "font/woff",
            "font/woff2",
            "application/pdf",
            "application/json"
          ]
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "schemaVersion",
        "securityClassification",
        "length",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "code-workspace"
        },
        "path": {
          "const": "components/code-workspace.json"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "securityClassification": {
          "const": "confidential-source"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "magic": {
              "const": "PVAD-PVADP-1"
            },
            "formatId": {
              "const": "pvadp"
            },
            "mediaType": {
              "const": "application/vnd.pvad.pvadp+zip"
            }
          }
        },
        {
          "properties": {
            "magic": {
              "const": "PVAD-PVADS-1"
            },
            "formatId": {
              "const": "pvads"
            },
            "mediaType": {
              "const": "application/vnd.pvad.pvads+zip"
            }
          }
        }
      ]
    }
  ]
}
