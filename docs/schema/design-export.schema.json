{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerdoxautomation.com/schemas/design-export.schema.json",
  "title": "DesignExportDto",
  "description": "A PVAD document design. POST to /api/export or /api/templates/render-design (optionally with a data payload for binding) to produce a PDF/Word/etc. file. Mirrors src/Core/PVAD.Core/Contracts/DesignExportDto.cs.",
  "type": "object",
  "required": ["id", "name", "pages"],
  "properties": {
    "id": { "type": "string", "description": "Unique design id." },
    "name": { "type": "string", "description": "Human-readable design name." },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "pages": {
      "type": "array",
      "description": "The pages of the document, rendered in order.",
      "items": { "$ref": "#/$defs/page" }
    },
    "sharedElements": {
      "type": "array",
      "description": "Elements repeated on every page (headers/footers/watermarks).",
      "items": { "$ref": "#/$defs/element" }
    },
    "pageSettings": { "$ref": "#/$defs/pageSettings" },
    "importDiagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/importDiagnostic" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "importDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "elements"],
      "properties": {
        "id": { "type": "string" },
        "layout": { "$ref": "#/$defs/pageLayout" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      },
      "additionalProperties": true
    },
    "pageLayout": {
      "type": "object",
      "description": "Optional physical layout override for one page. Omitted values inherit from pageSettings.",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "backgroundColor": { "type": "string" },
        "backgroundImage": { "type": ["string", "null"] },
        "backgroundImageFit": { "type": "string", "enum": ["cover", "contain", "fill", "tile"] },
        "margins": {
          "type": "object",
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        },
        "bleedSize": { "type": "number", "minimum": 0 },
        "complianceProfile": { "enum": ["None", "PdfA2B", "PdfA3B"] },
        "accessibilityProfile": { "enum": ["None", "PdfUa1"] }
      },
      "additionalProperties": true
    },
    "pageSettings": {
      "type": "object",
      "description": "Page geometry and document-level settings.",
      "properties": {
        "width": { "type": "number", "description": "Page width in points (595 = A4)." },
        "height": { "type": "number", "description": "Page height in points (842 = A4)." },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "unit": { "type": "string", "enum": ["px", "pt", "mm", "cm", "in"] },
        "backgroundColor": { "type": "string" },
        "bleedSize": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "element": {
      "type": "object",
      "description": "A single positioned element. Type-specific properties are permitted in addition to the common ones (see pvad-designer/src/docs/elementCatalog.ts for the per-type properties).",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "assetId": { "type": "string", "description": "Organization-owned asset ID in persisted Designer JSON or package-local asset ID inside PVADP." },
        "type": {
          "type": "string",
          "description": "The element type.",
          "enum": [
            "text", "image", "shape", "table", "line", "qrcode", "barcode", "signature",
            "richtext", "field", "textarea", "checkbox", "rect", "circle", "chart",
            "subsection", "area", "button", "dropdown", "optionlist", "radio", "watermark",
            "note", "arrow", "draw", "date", "highlight", "checkmark", "pageboundary",
            "pagenumber", "link", "number", "toc", "footnote", "endnote", "bookmark",
            "comment", "contentcontrol"
          ]
        },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "content": { "type": "string" },
        "style": { "type": "object", "additionalProperties": true },
        "binding": { "type": "string", "description": "Data path whose value replaces the content at render time." },
        "expression": { "type": "string", "description": "Template expression ($iif/$sum/$concat/...) evaluated at render time." },
        "visibleExpression": { "type": "string", "description": "Boolean expression gating visibility." },
        "accessibility": { "$ref": "#/$defs/accessibilityProperties" },
        "chart": { "$ref": "#/$defs/chartDefinition" },
        "chartType": { "type": "string", "description": "Legacy chart type; read for compatibility." },
        "chartData": { "type": "object", "description": "Legacy labels/datasets payload; read for compatibility." }
      },
      "additionalProperties": true
    },
    "accessibilityProperties": {
      "type": "object",
      "description": "Explicit logical semantics used for tagged PDF and PDF/UA output.",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["Document", "Part", "Sect", "Div", "P", "H1", "H2", "H3", "H4", "H5", "H6", "L", "LI", "Lbl", "LBody", "Table", "TR", "TH", "TD", "Span", "Link", "Figure", "Form"] },
        "customRole": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,126}$",
          "description": "Optional provider-specific PDF structure type mapped to role for PDF/UA-1 output."
        },
        "namespaceUri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Source semantic namespace. Native PDF namespace output is reserved for PDF 2.0/PDF/UA-2."
        },
        "isArtifact": { "type": "boolean" },
        "parentElementId": { "type": "string" },
        "readingOrder": { "type": "integer", "minimum": 0 },
        "language": { "type": "string" },
        "alternateText": { "type": "string" },
        "actualText": { "type": "string" },
        "tableHeaderScope": { "enum": ["None", "Row", "Column", "Both"] },
        "tableHeaderIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "chartDefinition": {
      "type": "object",
      "required": ["schemaVersion", "type", "categories", "series"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "type": { "enum": ["bar", "line", "area", "pie", "doughnut", "stackedBar", "combo"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "locale": { "type": "string", "description": "BCP 47 locale used for chart number formatting." },
        "categories": { "type": "array", "maxItems": 5000, "items": { "type": "string" } },
        "series": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/chartSeries" } },
        "legend": { "type": "object", "properties": { "visible": { "type": "boolean" }, "position": { "enum": ["top", "bottom", "left", "right"] } } },
        "dataLabels": { "type": "object", "properties": { "visible": { "type": "boolean" }, "position": { "type": "string" }, "numberFormat": { "type": "string" } } },
        "binding": { "type": "object", "properties": { "dataPath": { "type": "string" }, "categoryField": { "type": "string" }, "seriesField": { "type": "string" }, "valueField": { "type": "string" } } },
        "recognition": { "type": "object", "properties": { "status": { "enum": ["native", "automatic", "reviewRequired", "visualFallback"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "sourceKind": { "type": "string" }, "sourceAssetId": { "type": "string" }, "diagnosticCode": { "type": "string" } } }
      },
      "additionalProperties": true
    },
    "chartSeries": {
      "type": "object",
      "required": ["id", "name", "values"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["bar", "line", "area"] },
        "values": { "type": "array", "maxItems": 5000, "items": { "type": ["number", "null"] } },
        "color": { "type": "string" },
        "stackGroup": { "type": "string" },
        "valueAxisId": { "type": "string" },
        "fill": { "type": "boolean" },
        "showMarkers": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
