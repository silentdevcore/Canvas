<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PXA.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="AdminDocumentation/**/*" />
    <Content Include="AdminDocumentation/**/*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../product-metadata/designer-features.json"
                      LogicalName="PXA.ProductMetadata.designer-features.json" />
    <EmbeddedResource Include="../product-metadata/designer-releases.json"
                      LogicalName="PXA.ProductMetadata.designer-releases.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Importing/PXA.FileImporter/PXA.FileImporter.csproj" />
    <ProjectReference Include="../src/Importing/PXA.FileImporter.ImageAnalysis/PXA.FileImporter.ImageAnalysis.csproj" />
    <ProjectReference Include="../src/Importing/PXA.FileImporter.ImageOcr/PXA.FileImporter.ImageOcr.csproj" />
    <ProjectReference Include="../src/Importing/PXA.FileImporter.ImageOcr.Worker/PXA.FileImporter.ImageOcr.Worker.csproj" ReferenceOutputAssembly="false" OutputItemType="OcrWorkerProject" />
    <ProjectReference Include="../src/Importing/PXA.Importer/PXA.Importer.csproj" />
    <ProjectReference Include="../src/Core/PXA.Application/PXA.Application.csproj" />
    <ProjectReference Include="../src/Core/PXA.Core/PXA.Core.csproj" />
    <ProjectReference Include="../src/Infrastructure/PXA.Infrastructure.Converters/PXA.Infrastructure.Converters.csproj" />
    <ProjectReference Include="../src/Infrastructure/PXA.Infrastructure.Persistence/PXA.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="../src/Infrastructure/PXA.Infrastructure.Spreadsheet/PXA.Infrastructure.Spreadsheet.csproj" />
    <ProjectReference Include="../src/Infrastructure/PXA.Infrastructure.Word/PXA.Infrastructure.Word.csproj" />
    <ProjectReference Include="../src/Migrations/PDF/PXA.Migration.Pdf/PXA.Migration.Pdf.csproj" />
    <ProjectReference Include="../src/Migrations/Report/PXA.Migration.Report/PXA.Migration.Report.csproj" />
    <ProjectReference Include="../src/Migrations/Spreadsheet/PXA.Migration.Spreadsheet/PXA.Migration.Spreadsheet.csproj" />
  </ItemGroup>

  <Target Name="CopyImageOcrWorker" AfterTargets="Build" Condition="'$(SkipOcrWorkerPackaging)' != 'true'">
    <MSBuild Projects="../src/Importing/PXA.FileImporter.ImageOcr.Worker/PXA.FileImporter.ImageOcr.Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <ImageOcrWorkerFiles Include="../src/Importing/PXA.FileImporter.ImageOcr.Worker/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ImageOcrWorkerFiles)" DestinationFiles="@(ImageOcrWorkerFiles->'$(OutputPath)ocr-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
