<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/PXA.FileImporter/PXA.FileImporter.csproj" />
    <ProjectReference Include="../src/PXA.FileImporter.ImageAnalysis/PXA.FileImporter.ImageAnalysis.csproj" />
    <ProjectReference Include="../src/PXA.FileImporter.ImageOcr/PXA.FileImporter.ImageOcr.csproj" />
    <ProjectReference Include="../src/PXA.FileImporter.ImageOcr.Worker/PXA.FileImporter.ImageOcr.Worker.csproj" ReferenceOutputAssembly="false" OutputItemType="OcrWorkerProject" />
    <ProjectReference Include="../src/PXA.Importer/PXA.Importer.csproj" />
    <ProjectReference Include="../src/Canvas.Core/Canvas.Core.csproj" />
    <ProjectReference Include="../src/PXA.Application/PXA.Application.csproj" />
    <ProjectReference Include="../src/PXA.Core/PXA.Core.csproj" />
    <ProjectReference Include="../src/PXA.Infrastructure.Converters/PXA.Infrastructure.Converters.csproj" />
    <ProjectReference Include="../src/PXA.Infrastructure.Spreadsheet/PXA.Infrastructure.Spreadsheet.csproj" />
    <ProjectReference Include="../src/PXA.Infrastructure.Word/PXA.Infrastructure.Word.csproj" />
    <ProjectReference Include="../src/PXA.Migration.Pdf/PXA.Migration.Pdf.csproj" />
    <ProjectReference Include="../src/PXA.Migration.Report/PXA.Migration.Report.csproj" />
    <ProjectReference Include="../src/PXA.Migration.Spreadsheet/PXA.Migration.Spreadsheet.csproj" />
  </ItemGroup>

  <Target Name="CopyImageOcrWorker" AfterTargets="Build">
    <MSBuild Projects="../src/PXA.FileImporter.ImageOcr.Worker/PXA.FileImporter.ImageOcr.Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <ImageOcrWorkerFiles Include="../src/PXA.FileImporter.ImageOcr.Worker/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ImageOcrWorkerFiles)" DestinationFiles="@(ImageOcrWorkerFiles->'$(OutputPath)ocr-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
