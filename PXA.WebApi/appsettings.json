{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "pxa-webapi",
    "ServiceNamespace": "PowerDoxAutomation",
    "OtlpEndpoint": null,
    "ExportLogs": true,
    "ExportMetrics": true,
    "ExportTraces": true,
    "HealthCheckIntervalSeconds": 30,
    "AllowTemporaryDebugLogging": false,
    "DebugLoggingExpiresAtUtc": null,
    "EnableOcrFailureInjection": false,
    "OcrFailureInjectionCount": 3
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PxaDatabase": "Host=localhost;Port=5432;Database=pxa;Username=pxa;Password=pxa-local"
  },
  "Pdf": {
    "FontsDirectory": "fonts"
  },
  "Mail": {
    "Enabled": true,
    "Transport": "Disabled",
    "AdminBaseUrl": "http://localhost:5177",
    "AccountBaseUrl": "http://localhost:5178",
    "CompanyBaseUrl": "http://localhost:5173",
    "DesignerBaseUrl": "http://localhost:5176",
    "SupportUrl": "http://localhost:5173/support.html",
    "SenderName": "Power Dox Automation",
    "SenderAddress": "no-reply@powerdoxautomation.com",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUseTls": false,
    "SmtpTimeoutSeconds": 30,
    "DeliveredRetentionDays": 30,
    "CancelledRetentionDays": 14,
    "DeadLetterRetentionDays": 90,
    "RetentionCleanupIntervalMinutes": 60,
    "RetentionBatchSize": 500
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/objects",
    "MaximumObjectBytes": 104857600
  },
  "Jobs": {
    "PollIntervalSeconds": 2,
    "LeaseMinutes": 10,
    "MaximumAttempts": 3,
    "ResultRetentionDays": 7,
    "TransientRetentionHours": 24,
    "TerminalMetadataRetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100,
    "MetricsIntervalSeconds": 15
  },
  "DataProtection": {
    "KeysDirectory": "App_Data/data-protection-keys"
  },
  "Licensing": {
    "KeyId": "pxa-development-1",
    "PrivateKeyPath": "App_Data/licensing/private-key.pem",
    "PublicKeyPath": "App_Data/licensing/public-key.pem",
    "MetricsIntervalSeconds": 60
  },
  "ProductAccess": {
    "Enabled": false
  },
  "ConsumerCheckout": {
    "Enabled": false
  },
  "Registration": {
    "TermsVersion": "2026-07",
    "PrivacyVersion": "2026-07",
    "RequireCurrentTermsAcceptance": false,
    "RequireCurrentPrivacyAcknowledgement": false,
    "RequireDatabaseLegalDocuments": false,
    "AllowedReturnOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://localhost:5176",
      "http://localhost:5178",
      "https://powerdoxautomation.com",
      "https://docs.powerdoxautomation.com",
      "https://demos.powerdoxautomation.com",
      "https://designer.powerdoxautomation.com",
      "https://account.powerdoxautomation.com"
    ]
  },
  "DesignerAuthentication": {
    "AllowedOrigins": [
      "http://localhost:5176",
      "https://designer.powerdoxautomation.com"
    ]
  },
  "DesignerTemplates": {
    "MaximumDesignJsonBytes": 10485760,
    "MaximumPageSize": 100
  }
}
