{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "pxa-webapi",
    "ServiceNamespace": "PowerDoxAutomation",
    "OtlpEndpoint": null,
    "ExportLogs": true,
    "ExportMetrics": true,
    "ExportTraces": true,
    "HealthCheckIntervalSeconds": 30,
    "AllowTemporaryDebugLogging": false,
    "DebugLoggingExpiresAtUtc": null,
    "EnableOcrFailureInjection": false,
    "OcrFailureInjectionCount": 3
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PxaDatabase": "Host=localhost;Port=5432;Database=pxa;Username=pxa;Password=pxa-local"
  },
  "PdfTrust": {
    "Runtime": {
      "DeploymentMode": "Cloud",
      "OfflineMode": false,
      "SigningEnabled": true,
      "RedactionEnabled": true,
      "ComplianceEnabled": true,
      "KeyProviderAdapter": "Pkcs12Upload",
      "KeyProviderEndpoint": null,
      "PdfAValidatorBinary": null,
      "PdfUaValidatorBinary": null,
      "RequireTimestampAuthorityForSigning": false,
      "AuditRetentionDays": 2555
    },
    "RevocationEvidence": {
      "Enabled": false,
      "AllowedHosts": [],
      "CrlPaths": [],
      "OcspResponsePaths": [],
      "CacheDirectory": "App_Data/pdf-trust/revocation-cache",
      "MaximumResponseBytes": 4194304,
      "NetworkTimeoutSeconds": 10,
      "MaximumOcspAgeHours": 24
    },
    "TimestampAuthority": {
      "Endpoint": null,
      "MaximumResponseBytes": 1048576,
      "RequireTrustedCertificateChain": true
    },
    "ValidationPolicy": {
      "UseSystemTrustStore": true,
      "CustomTrustAnchorPaths": [],
      "IntermediateCertificatePaths": [],
      "RevocationMode": "NoCheck",
      "RevocationFlag": "ExcludeRoot",
      "AllowCertificateDownloads": false,
      "NetworkTimeoutSeconds": 10
    }
  },
  "Security": {
    "StepUp": {
      "MaximumAuthenticationAgeMinutes": 15
    }
  },
  "Pdf": {
    "FontsDirectory": "fonts"
  },
  "Mail": {
    "Enabled": true,
    "Transport": "Disabled",
    "AdminBaseUrl": "http://localhost:5177",
    "AccountBaseUrl": "http://localhost:5178",
    "CompanyBaseUrl": "http://localhost:5173",
    "DesignerBaseUrl": "http://localhost:5176",
    "SupportUrl": "http://localhost:5173/support.html",
    "SenderName": "Power Dox Automation",
    "SenderAddress": "no-reply@powerdoxautomation.com",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUseTls": false,
    "SmtpTimeoutSeconds": 30,
    "DeliveredRetentionDays": 30,
    "CancelledRetentionDays": 14,
    "DeadLetterRetentionDays": 90,
    "RetentionCleanupIntervalMinutes": 60,
    "RetentionBatchSize": 500
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/objects",
    "MaximumObjectBytes": 104857600,
    "MaximumDesignerAssetBytes": 10485760
  },
  "Jobs": {
    "PollIntervalSeconds": 2,
    "LeaseMinutes": 10,
    "MaximumAttempts": 3,
    "ResultRetentionDays": 7,
    "TransientRetentionHours": 24,
    "TerminalMetadataRetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100,
    "MetricsIntervalSeconds": 15
  },
  "DataProtection": {
    "KeysDirectory": "App_Data/data-protection-keys"
  },
  "Licensing": {
    "KeyId": "pxa-development-1",
    "PrivateKeyPath": "App_Data/licensing/private-key.pem",
    "PublicKeyPath": "App_Data/licensing/public-key.pem",
    "MetricsIntervalSeconds": 60
  },
  "ProductAccess": {
    "Enabled": false
  },
  "OAuth": {
    "Enabled": true,
    "Issuer": "http://localhost:5178",
    "McpResource": "http://localhost:3000/mcp",
    "ApiResource": "pxa-api",
    "PublicClientId": "pxa-mcp-public",
    "DynamicClientRegistrationEnabled": true,
    "DynamicClientMaximumRedirectUris": 10,
    "PublicClientRedirectUris": [
      "http://localhost:3001/oauth/callback",
      "http://127.0.0.1:3001/oauth/callback"
    ],
    "McpServerClientSecret": null,
    "McpDelegationSecret": null,
    "SigningCertificatePath": null,
    "SigningCertificatePassword": null
  },
  "ConsumerCheckout": {
    "Enabled": false
  },
  "Registration": {
    "TermsVersion": "2026-07",
    "PrivacyVersion": "2026-07",
    "RequireCurrentTermsAcceptance": false,
    "RequireCurrentPrivacyAcknowledgement": false,
    "RequireDatabaseLegalDocuments": false,
    "AllowedReturnOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://localhost:5176",
      "http://localhost:5178",
      "https://powerdoxautomation.com",
      "https://docs.powerdoxautomation.com",
      "https://demos.powerdoxautomation.com",
      "https://designer.powerdoxautomation.com",
      "https://account.powerdoxautomation.com"
    ]
  },
  "DesignerAuthentication": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5176",
      "https://designer.powerdoxautomation.com"
    ]
  },
  "DesignerTemplates": {
    "MaximumDesignJsonBytes": 10485760,
    "MaximumPageSize": 100
  }
}
