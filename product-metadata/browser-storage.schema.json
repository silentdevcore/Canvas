{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerdoxautomation.com/schemas/browser-storage.schema.json",
  "title": "PXA browser storage inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "optionalStorageEnabled", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "optionalStorageEnabled": { "type": "boolean" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mechanism", "keys", "applications", "owner", "category", "purpose", "data", "lifetime", "optional", "serverManaged", "sourceFiles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "mechanism": { "enum": ["cookie", "localStorage", "sessionStorage"] },
          "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "applications": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 3 },
          "category": { "enum": ["strictly-necessary", "requested-preference", "requested-application-state", "analytics", "marketing"] },
          "purpose": { "type": "string", "minLength": 12 },
          "data": { "type": "string", "minLength": 8 },
          "lifetime": { "type": "string", "minLength": 3 },
          "optional": { "type": "boolean" },
          "serverManaged": { "type": "boolean" },
          "sourceFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
        }
      }
    }
  }
}
