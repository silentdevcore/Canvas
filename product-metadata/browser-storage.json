{
  "$schema": "./browser-storage.schema.json",
  "schemaVersion": 1,
  "reviewedAt": "2026-08-01",
  "optionalStorageEnabled": false,
  "entries": [
    {
      "id": "public.storage-notice",
      "mechanism": "cookie",
      "keys": ["PXA.StorageNotice"],
      "applications": ["account", "company", "demo", "documentation"],
      "owner": "PXA Web Platform",
      "category": "strictly-necessary",
      "purpose": "Remembers that the visitor acknowledged the necessary-storage notice.",
      "data": "Storage-notice version only; no user or device identifier.",
      "lifetime": "180 days",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["websites/shared/storageNotice.js"]
    },
    {
      "id": "identity.account-session",
      "mechanism": "cookie",
      "keys": ["__Host-PXA.Session", "PXA.Session.Development"],
      "applications": ["account", "admin"],
      "owner": "PXA Identity",
      "category": "strictly-necessary",
      "purpose": "Authenticates the current Account or Admin browser session.",
      "data": "Protected authentication ticket; HttpOnly and unavailable to application JavaScript.",
      "lifetime": "8 hours with sliding renewal",
      "optional": false,
      "serverManaged": true,
      "sourceFiles": ["PXA.WebApi/Program.cs"]
    },
    {
      "id": "identity.designer-session",
      "mechanism": "cookie",
      "keys": ["__Host-PXA.Designer.Session", "PXA.Designer.Session.Development"],
      "applications": ["designer"],
      "owner": "PXA Identity",
      "category": "strictly-necessary",
      "purpose": "Authenticates the isolated Designer browser session.",
      "data": "Protected authentication ticket; HttpOnly and unavailable to application JavaScript.",
      "lifetime": "8 hours with sliding renewal",
      "optional": false,
      "serverManaged": true,
      "sourceFiles": ["PXA.WebApi/Program.cs"]
    },
    {
      "id": "security.antiforgery",
      "mechanism": "cookie",
      "keys": ["__Host-PXA.Antiforgery", "PXA.Antiforgery.Development"],
      "applications": ["account", "admin", "designer"],
      "owner": "PXA Security",
      "category": "strictly-necessary",
      "purpose": "Protects authenticated state-changing requests against cross-site request forgery.",
      "data": "Opaque anti-forgery token; HttpOnly and unavailable to application JavaScript.",
      "lifetime": "Browser session",
      "optional": false,
      "serverManaged": true,
      "sourceFiles": ["PXA.WebApi/Program.cs"]
    },
    {
      "id": "preference.locale",
      "mechanism": "localStorage",
      "keys": ["pxa_locale"],
      "applications": ["account", "designer"],
      "owner": "PXA Localization",
      "category": "requested-preference",
      "purpose": "Keeps the language explicitly selected by the user.",
      "data": "Supported language code.",
      "lifetime": "Until the user changes it or clears site data",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["websites/PXA.Account/src/authI18n.ts", "pxa-designer/src/i18n/index.ts"]
    },
    {
      "id": "designer.auth-transaction",
      "mechanism": "sessionStorage",
      "keys": ["pxa.designer.auth-transaction"],
      "applications": ["designer"],
      "owner": "PXA Identity",
      "category": "strictly-necessary",
      "purpose": "Completes the one-time Account-to-Designer PKCE authorization handoff.",
      "data": "PKCE verifier, state, safe return path, and creation time.",
      "lifetime": "Consumed on callback or removed when the browser tab closes",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/auth/designerAuth.ts"]
    },
    {
      "id": "designer.migration-handoff",
      "mechanism": "sessionStorage",
      "keys": ["pxa_migration_designer_handoff"],
      "applications": ["designer"],
      "owner": "PXA Migration",
      "category": "strictly-necessary",
      "purpose": "Transfers one migrated design into the editor without placing document content in the URL.",
      "data": "Migrated template JSON and page settings.",
      "lifetime": "Consumed when the editor opens or removed when the browser tab closes",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/pages/MigrationsPage.tsx", "pxa-designer/src/pages/CreatePage.tsx"]
    },
    {
      "id": "designer.pdf-viewer-handoff",
      "mechanism": "sessionStorage",
      "keys": ["pdf_viewer_handoff"],
      "applications": ["designer"],
      "owner": "PXA PDF Viewer",
      "category": "strictly-necessary",
      "purpose": "Transfers one PDF source into the viewer without placing document content in the URL.",
      "data": "PDF data URL or source URL and display name.",
      "lifetime": "Consumed when the viewer opens or removed when the browser tab closes",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/features/pdf-viewer/handoff.ts"]
    },
    {
      "id": "designer.editor-mode",
      "mechanism": "localStorage",
      "keys": ["editor-storage"],
      "applications": ["designer"],
      "owner": "PXA Designer",
      "category": "requested-preference",
      "purpose": "Keeps the selected document editing mode between visits.",
      "data": "Document-mode preference only; customer templates are excluded.",
      "lifetime": "Until sign-out, organization switch, or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/store.ts", "pxa-designer/src/auth/designerTenantState.ts"]
    },
    {
      "id": "designer.spreadsheet-draft",
      "mechanism": "localStorage",
      "keys": ["pxa-spreadsheet"],
      "applications": ["designer"],
      "owner": "PXA Spreadsheet",
      "category": "requested-application-state",
      "purpose": "Restores the locally edited workbook after an accidental refresh.",
      "data": "Workbook name, sheets, cells, and active-sheet index; may contain customer-entered content.",
      "lifetime": "Until sign-out, organization switch, replacement, or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/spreadsheet/store.ts", "pxa-designer/src/auth/designerTenantState.ts"]
    },
    {
      "id": "designer.code-draft",
      "mechanism": "localStorage",
      "keys": ["pxa-code-editor-draft-v2"],
      "applications": ["designer"],
      "owner": "PXA Code Editor",
      "category": "requested-application-state",
      "purpose": "Restores the code or JSON draft after an accidental refresh.",
      "data": "User-edited C# or design JSON; may contain customer-entered content.",
      "lifetime": "Until sign-out, organization switch, replacement, or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/components/CodeEditor/LiveCodeEditor.tsx", "pxa-designer/src/auth/designerTenantState.ts"]
    },
    {
      "id": "designer.code-language",
      "mechanism": "localStorage",
      "keys": ["pxa-code-editor-lang-v2"],
      "applications": ["designer"],
      "owner": "PXA Code Editor",
      "category": "requested-preference",
      "purpose": "Keeps the selected code-editor language mode.",
      "data": "Language-mode identifier.",
      "lifetime": "Until changed or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/components/CodeEditor/LiveCodeEditor.tsx"]
    },
    {
      "id": "designer.export-format",
      "mechanism": "localStorage",
      "keys": ["pxa_export_format"],
      "applications": ["designer"],
      "owner": "PXA Export",
      "category": "requested-preference",
      "purpose": "Highlights the export format most recently chosen by the user.",
      "data": "Export-format identifier only.",
      "lifetime": "Until changed or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/components/Editor/ExportModal.tsx"]
    },
    {
      "id": "designer.pdf-sidebar",
      "mechanism": "localStorage",
      "keys": ["pxa-designer:pdf-sidebar-collapsed"],
      "applications": ["designer"],
      "owner": "PXA Designer",
      "category": "requested-preference",
      "purpose": "Keeps the PDF navigation sidebar in the state selected by the user.",
      "data": "Collapsed or expanded flag.",
      "lifetime": "Until changed or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/hooks/useSidebarCollapsed.ts", "pxa-designer/src/components/Layout/PdfLayout.tsx"]
    },
    {
      "id": "designer.spreadsheet-sidebar",
      "mechanism": "localStorage",
      "keys": ["pxa-designer:spreadsheet-sidebar-collapsed"],
      "applications": ["designer"],
      "owner": "PXA Designer",
      "category": "requested-preference",
      "purpose": "Keeps the Spreadsheet navigation sidebar in the state selected by the user.",
      "data": "Collapsed or expanded flag.",
      "lifetime": "Until changed or site-data deletion",
      "optional": false,
      "serverManaged": false,
      "sourceFiles": ["pxa-designer/src/hooks/useSidebarCollapsed.ts", "pxa-designer/src/components/Layout/SpreadsheetLayout.tsx"]
    }
  ]
}
