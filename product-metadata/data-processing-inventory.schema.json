{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerdoxautomation.com/schemas/data-processing-inventory.schema.json",
  "title": "PXA data processing inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "productionApproved", "controllerIdentity", "defaultRegionPolicy", "coverage", "activities", "providers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "productionApproved": { "type": "boolean" },
    "controllerIdentity": { "type": "string", "minLength": 3 },
    "defaultRegionPolicy": { "type": "string", "minLength": 12 },
    "coverage": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "purposes", "dataSubjects", "dataCategories", "systems", "entities", "providerIds", "region", "transfer", "retention", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 8 },
          "role": { "enum": ["controller", "processor-for-customer-content", "controller-and-local-customer-state", "controller-and-processor-continuity"] },
          "purposes": { "$ref": "#/$defs/stringList" },
          "dataSubjects": { "$ref": "#/$defs/stringList" },
          "dataCategories": { "$ref": "#/$defs/stringList" },
          "systems": { "$ref": "#/$defs/stringList" },
          "entities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "providerIds": { "$ref": "#/$defs/stringList" },
          "region": { "type": "string", "minLength": 3 },
          "transfer": { "type": "string", "minLength": 3 },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "approvalStatus", "rule", "legalApprovalRequired"],
            "properties": {
              "status": { "enum": ["transient", "documented", "enforced", "partially-enforced", "legal-review-required"] },
              "approvalStatus": { "enum": ["approved", "pending-legal"] },
              "rule": { "type": "string", "minLength": 20 },
              "configuration": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
              "legalApprovalRequired": { "type": "boolean" }
            }
          },
          "sources": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "deployment", "receivesCustomerContent", "region", "transferRisk", "approval"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "type": "string", "minLength": 3 },
          "deployment": { "type": "string", "minLength": 3 },
          "receivesCustomerContent": { "type": "boolean" },
          "region": { "type": "string", "minLength": 3 },
          "transferRisk": { "type": "string", "minLength": 3 },
          "approval": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } }
  }
}
