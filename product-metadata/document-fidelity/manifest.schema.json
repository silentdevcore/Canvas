{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerdoxautomation.com/schemas/document-fidelity-manifest.schema.json",
  "title": "PXA document fidelity corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumGeometryDriftPoints", "minimumTextPreservationRatio", "maximumVisualDifferenceRatio", "minimumAutomaticMigrationPercent"],
      "properties": {
        "maximumGeometryDriftPoints": { "type": "number", "minimum": 0 },
        "minimumTextPreservationRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumVisualDifferenceRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumAutomaticMigrationPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "workflow", "sourceFormat", "source", "provenance", "redistribution", "realWorld", "officiallySupported", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "domain": { "enum": ["pdf", "word", "spreadsheet", "report"] },
          "workflow": { "enum": ["import-roundtrip", "export-roundtrip", "code-migration", "designer-migration", "render-parity", "standards-validation"] },
          "sourceFormat": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "provenance": { "enum": ["pxa-synthetic", "third-party-generated", "public-real-world", "customer-anonymized"] },
          "redistribution": { "enum": ["allowed", "restricted"] },
          "realWorld": { "type": "boolean" },
          "officiallySupported": { "type": "boolean" },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
