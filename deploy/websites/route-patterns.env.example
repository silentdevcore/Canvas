# Copy exactly one pattern value into PVAD_SPA_ROUTE_PATTERN in the deployment.
# Keep the anchors: unknown paths must fall through to the true 404 handler.

# PVADE Company (clean aliases; .html files are served directly)
PVAD_COMPANY_ROUTE_PATTERN=^/(|products|pricing|about|support|contact|terms|privacy|license)/?$

# PVADE Documentation
PVAD_DOCUMENTATION_ROUTE_PATTERN=^/(|editor|code|migration|api|cookbook)(/.*)?$

# PVAD.Demo
PVAD_DEMO_ROUTE_PATTERN=^/(|pdf|designer|report|migration|spreadsheet|import-export)(/.*)?$

# PVADE Account
PVAD_ACCOUNT_ROUTE_PATTERN=^/(|login|register|verify-email|designer-authorize|dashboard|profile|organization|subscription|usage|licenses|developer-access|security|support|closure)(/.*)?$

# PVADE Admin
PVAD_ADMIN_ROUTE_PATTERN=^/(|login|dashboard|users|organizations|roles|subscriptions|licenses|service-accounts|mail|audit|settings|documentation)(/.*)?$

# PVADE Designer
PVAD_DESIGNER_ROUTE_PATTERN=^/(|pdf|create|template|templates|importer|pdf-viewer|report|migrations|spreadsheet|spreadsheet-editor|spreadsheet-import|convert-to-pdf|import|docs|auth|open-project)(/.*)?$
