# Copy exactly one PXA_SPA_ROUTE_PATTERN into a deployment environment.
# Keep the anchors: unknown paths must fall through to the true 404 handler.

# PXA.Company (clean aliases; .html files are served directly)
PXA_COMPANY_ROUTE_PATTERN=^/(|products|pricing|about|support|contact|terms|privacy|license)/?$

# PXA.Documentation
PXA_DOCUMENTATION_ROUTE_PATTERN=^/(|editor|code|migration|api|cookbook)(/.*)?$

# PXA.Demo
PXA_DEMO_ROUTE_PATTERN=^/(|pdf|designer|report|migration|spreadsheet|import-export)(/.*)?$

# PXA.Account
PXA_ACCOUNT_ROUTE_PATTERN=^/(|login|register|verify-email|designer-authorize|dashboard|profile|organization|subscription|usage|licenses|developer-access|security|support|closure)(/.*)?$

# PXA.Admin
PXA_ADMIN_ROUTE_PATTERN=^/(|login|dashboard|users|organizations|roles|subscriptions|licenses|service-accounts|mail|audit|settings|documentation)(/.*)?$

# PXA Designer
PXA_DESIGNER_ROUTE_PATTERN=^/(|pdf|create|templates|migrations|spreadsheet|spreadsheet-editor|spreadsheet-import|convert-to-pdf|import|docs|auth)(/.*)?$
