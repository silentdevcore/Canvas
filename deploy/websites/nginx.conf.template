server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # API failures keep their RFC 9457 response and status; they are never replaced
    # with an HTML status page.
    location /api/ {
        proxy_pass ${PXA_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 @api_unavailable;
    }

    location @api_unavailable {
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 503 '{"type":"about:blank","title":"PXA API is unavailable","status":503,"code":"PXAAPI018"}';
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files /index.html =500;
    }

    # Repeated character classes avoid `${...}`-like regex quantifiers because
    # the official image processes this file with envsubst.
    location ~* ^/assets/.*[.-][a-z0-9_-][a-z0-9_-][a-z0-9_-][a-z0-9_-][a-z0-9_-][a-z0-9_-][a-z0-9_-][a-z0-9_-].*\.(css|js|map|png|jpe?g|gif|svg|webp|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The pattern is application-specific. Only known SPA routes receive index.html
    # with HTTP 200. An unknown path reaches the real 404 handler below.
    location ~ ${PXA_SPA_ROUTE_PATTERN} {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    error_page 500 502 504 /500.html;
    error_page 503 /maintenance.html;

    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /500.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /maintenance.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "300" always;
        add_header X-Robots-Tag "noindex" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
