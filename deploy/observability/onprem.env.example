# Copy to deployment-owned configuration and tune after a measured capacity test.
# Do not store credentials or customer-specific hostnames in this file.

# Retention and sampling
PXA_METRIC_RETENTION=90d
PXA_METRIC_RETENTION_SIZE=0B
PXA_LOG_RETENTION=720h
PXA_TRACE_RETENTION=336h
PXA_ALERT_RETENTION=120h
PXA_TRACE_SAMPLE_PERCENTAGE=10
PXA_LOKI_CONFIG_PATH=./deploy/observability/loki/config.yml
PXA_TEMPO_CONFIG_PATH=./deploy/observability/tempo/config.yml

# Persistent storage. Absolute paths create bind mounts; defaults use named volumes.
PXA_PROMETHEUS_DATA_PATH=pxa-prometheus-data
PXA_ALERTMANAGER_DATA_PATH=pxa-alertmanager-data
PXA_LOKI_DATA_PATH=pxa-loki-data
PXA_TEMPO_DATA_PATH=pxa-tempo-data
PXA_GRAFANA_DATA_PATH=pxa-grafana-data

# Collector
PXA_OTEL_CPU_LIMIT=1.0
PXA_OTEL_MEMORY_LIMIT=512M
PXA_OTEL_MEMORY_LIMIT_MIB=384
PXA_OTEL_MEMORY_SPIKE_LIMIT_MIB=96

# Storage and visualization
PXA_PROMETHEUS_CPU_LIMIT=1.0
PXA_PROMETHEUS_MEMORY_LIMIT=1G
PXA_LOKI_CPU_LIMIT=1.0
PXA_LOKI_MEMORY_LIMIT=1G
PXA_TEMPO_CPU_LIMIT=1.0
PXA_TEMPO_MEMORY_LIMIT=1G
PXA_GRAFANA_CPU_LIMIT=1.0
PXA_GRAFANA_MEMORY_LIMIT=768M
PXA_ALERTMANAGER_CPU_LIMIT=0.5
PXA_ALERTMANAGER_MEMORY_LIMIT=256M

# Supporting exporters and gateway
PXA_POSTGRES_EXPORTER_CPU_LIMIT=0.25
PXA_POSTGRES_EXPORTER_MEMORY_LIMIT=128M
PXA_CADVISOR_CPU_LIMIT=0.5
PXA_CADVISOR_MEMORY_LIMIT=256M
PXA_BLACKBOX_CPU_LIMIT=0.25
PXA_BLACKBOX_MEMORY_LIMIT=128M
PXA_OPERATOR_GATEWAY_CPU_LIMIT=0.25
PXA_OPERATOR_GATEWAY_MEMORY_LIMIT=128M

# Directory containing deployment-owned Prometheus file_sd JSON files.
PXA_TLS_TARGETS_PATH=./deploy/observability/prometheus/targets
