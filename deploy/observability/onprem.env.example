# Copy to deployment-owned configuration and tune after a measured capacity test.
# Do not store credentials or customer-specific hostnames in this file.

# Retention and sampling
PVAD_METRIC_RETENTION=90d
PVAD_METRIC_RETENTION_SIZE=0B
PVAD_LOG_RETENTION=720h
PVAD_TRACE_RETENTION=336h
PVAD_ALERT_RETENTION=120h
PVAD_TRACE_SAMPLE_PERCENTAGE=10
PVAD_LOKI_CONFIG_PATH=./deploy/observability/loki/config.yml
PVAD_TEMPO_CONFIG_PATH=./deploy/observability/tempo/config.yml

# Persistent storage. Absolute paths create bind mounts; defaults use named volumes.
PVAD_PROMETHEUS_DATA_PATH=pvad-prometheus-data
PVAD_ALERTMANAGER_DATA_PATH=pvad-alertmanager-data
PVAD_LOKI_DATA_PATH=pvad-loki-data
PVAD_TEMPO_DATA_PATH=pvad-tempo-data
PVAD_GRAFANA_DATA_PATH=pvad-grafana-data

# Collector
PVAD_OTEL_CPU_LIMIT=1.0
PVAD_OTEL_MEMORY_LIMIT=512M
PVAD_OTEL_MEMORY_LIMIT_MIB=384
PVAD_OTEL_MEMORY_SPIKE_LIMIT_MIB=96

# Storage and visualization
PVAD_PROMETHEUS_CPU_LIMIT=1.0
PVAD_PROMETHEUS_MEMORY_LIMIT=1G
PVAD_LOKI_CPU_LIMIT=1.0
PVAD_LOKI_MEMORY_LIMIT=1G
PVAD_TEMPO_CPU_LIMIT=1.0
PVAD_TEMPO_MEMORY_LIMIT=1G
PVAD_GRAFANA_CPU_LIMIT=1.0
PVAD_GRAFANA_MEMORY_LIMIT=768M
PVAD_ALERTMANAGER_CPU_LIMIT=0.5
PVAD_ALERTMANAGER_MEMORY_LIMIT=256M

# Supporting exporters and gateway
PVAD_POSTGRES_EXPORTER_CPU_LIMIT=0.25
PVAD_POSTGRES_EXPORTER_MEMORY_LIMIT=128M
PVAD_CADVISOR_CPU_LIMIT=0.5
PVAD_CADVISOR_MEMORY_LIMIT=256M
PVAD_BLACKBOX_CPU_LIMIT=0.25
PVAD_BLACKBOX_MEMORY_LIMIT=128M
PVAD_OPERATOR_GATEWAY_CPU_LIMIT=0.25
PVAD_OPERATOR_GATEWAY_MEMORY_LIMIT=128M

# Directory containing deployment-owned Prometheus file_sd JSON files.
PVAD_TLS_TARGETS_PATH=./deploy/observability/prometheus/targets
