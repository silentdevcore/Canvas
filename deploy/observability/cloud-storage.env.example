# Cloud object-storage configuration. Copy to deployment-owned configuration.
# Prefer workload identity. Do not place static S3 credentials in this file.

PXA_LOKI_CONFIG_PATH=./deploy/observability/loki/config.s3.yml
PXA_TEMPO_CONFIG_PATH=./deploy/observability/tempo/config.s3.yml

PXA_S3_REGION=eu-central-1
PXA_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PXA_S3_FORCE_PATH_STYLE=false
PXA_S3_INSECURE=false
PXA_LOKI_S3_BUCKET=replace-with-loki-bucket
PXA_TEMPO_S3_BUCKET=replace-with-tempo-bucket

PXA_LOG_RETENTION=720h
PXA_TRACE_RETENTION=336h
PXA_TRACE_SAMPLE_PERCENTAGE=10
