# Cloud object-storage configuration. Copy to deployment-owned configuration.
# Prefer workload identity. Do not place static S3 credentials in this file.

PVAD_LOKI_CONFIG_PATH=./deploy/observability/loki/config.s3.yml
PVAD_TEMPO_CONFIG_PATH=./deploy/observability/tempo/config.s3.yml

PVAD_S3_REGION=eu-central-1
PVAD_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PVAD_S3_FORCE_PATH_STYLE=false
PVAD_S3_INSECURE=false
PVAD_LOKI_S3_BUCKET=replace-with-loki-bucket
PVAD_TEMPO_S3_BUCKET=replace-with-tempo-bucket

PVAD_LOG_RETENTION=720h
PVAD_TRACE_RETENTION=336h
PVAD_TRACE_SAMPLE_PERCENTAGE=10
