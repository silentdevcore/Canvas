# PXA On-Premise Small: one API replica, up to four concurrent document operations.
PXA_API_CPU_LIMIT=1.0
PXA_API_MEMORY_LIMIT=2G
PXA_OTEL_CPU_LIMIT=0.5
PXA_OTEL_MEMORY_LIMIT=512M
PXA_PROMETHEUS_CPU_LIMIT=1.0
PXA_PROMETHEUS_MEMORY_LIMIT=1G
PXA_LOKI_CPU_LIMIT=1.0
PXA_LOKI_MEMORY_LIMIT=1G
PXA_TEMPO_CPU_LIMIT=1.0
PXA_TEMPO_MEMORY_LIMIT=1G
PXA_GRAFANA_CPU_LIMIT=0.5
PXA_GRAFANA_MEMORY_LIMIT=512M
PXA_TRACE_SAMPLE_PERCENTAGE=10
PXA_METRIC_RETENTION=90d
PXA_LOG_RETENTION=720h
PXA_TRACE_RETENTION=336h
