# Copy outside the repository and fill only with inspected existing resource IDs.
# Blank required bindings intentionally fail configuration; no resources are guessed.
# Select the SAME installed project; never substitute a new branding-based project.
COMPOSE_PROJECT_NAME=

# Both stacks
PVAD_LEGACY_DATABASE_VOLUME=

# Root observability stack
PVAD_LEGACY_MAILPIT_VOLUME=
PVAD_LEGACY_PROMETHEUS_VOLUME=
PVAD_LEGACY_LOKI_VOLUME=
PVAD_LEGACY_TEMPO_VOLUME=
PVAD_LEGACY_GRAFANA_VOLUME=
PVAD_LEGACY_ALERTMANAGER_VOLUME=
PVAD_LEGACY_OBSERVABILITY_NETWORK=
PVAD_LEGACY_INGRESS_NETWORK=
PVAD_LEGACY_HOST_NETWORK=
PVAD_LEGACY_EGRESS_NETWORK=

# API/MCP stack
PVAD_LEGACY_API_VOLUME=
PVAD_LEGACY_API_HOST_NETWORK=

# Optional overrides: use the ACTUAL existing values, not fresh-install defaults.
# PVAD_DATABASE_NAME=pxa
# PVAD_DATABASE_USER=pxa
# PVAD_DATABASE_PASSWORD=replace-with-existing-password-outside-source-control
# PVAD_GRAFANA_ADMIN_USER=pxa-operator
# PVAD_GRAFANA_ADMIN_PASSWORD=replace-with-existing-password-outside-source-control
# PVAD_LICENSE_PRIVATE_KEY_FILE=/absolute/existing/private.pem
# PVAD_LICENSE_PUBLIC_KEY_FILE=/absolute/existing/public.pem
