{
  "id": "/",
  "name": "PVADE Designer",
  "short_name": "PVADE",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#087f73",
  "icons": [
    { "src": "/icons/project-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/project-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "file_handlers": [
    {
      "action": "/open-project",
      "launch_type": "multiple-clients",
      "accept": {
        "application/vnd.pvad.pvadp+zip": [".pvadp"],
        "application/vnd.pvad.pvads+zip": [".pvads"]
      }
    }
  ]
}
