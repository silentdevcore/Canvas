        { "identifier": "10", "description": "Unit", "quantity": 1, "unitCode": "C62", "unitPrice": 0.1, "taxRate": 19, "taxCategoryCode": "S" }
      ],
      "expected": {
        "lineNetAmounts": ["0.10", "0.10", "0.10", "0.10", "0.10", "0.10", "0.10", "0.10", "0.10", "0.10"],
        "taxes": [{ "categoryCode": "S", "rate": "19", "basis": "1.00", "amount": "0.19" }],
        "lineNetTotal": "1.00",
        "taxTotal": "0.19",
        "grandTotal": "1.19"
      }
    },
