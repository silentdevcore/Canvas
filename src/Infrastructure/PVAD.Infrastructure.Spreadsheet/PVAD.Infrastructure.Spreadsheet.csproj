<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/PVAD.Core/PVAD.Core.csproj" />
    <ProjectReference Include="../../Core/PVAD.Application/PVAD.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- Override the vulnerable build task brought in by NPOI's SourceLink dependency. -->
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.403" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
