<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="PVAD.Importer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Infrastructure/PVAD.Infrastructure.Pdf/PVAD.Infrastructure.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreJ2K" Version="2.3.3.91" />
    <PackageReference Include="JBig2Decoder.NETStandard" Version="1.5.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
