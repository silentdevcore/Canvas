<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Emit XML docs for the public contracts (DesignExportDto et al.) for DocFX/IntelliSense.
         CS1591 suppressed for incremental documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Canvas.Domain/Canvas.Domain.csproj" />
  </ItemGroup>

</Project>
