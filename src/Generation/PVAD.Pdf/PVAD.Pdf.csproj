<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Emit the XML doc file for the PVAD.Generator.Pdf engine API for DocFX/IntelliSense.
         CS1591 is suppressed so undocumented members don't flood the build while we document incrementally. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PVAD.Infrastructure.Pdf" />
    <InternalsVisibleTo Include="PVAD.Infrastructure.Pdf.Tests" />
    <InternalsVisibleTo Include="PVAD.Importer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
