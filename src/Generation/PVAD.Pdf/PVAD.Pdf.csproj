<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Emit the XML doc file for the PVAD.Generator.Pdf engine API for DocFX/IntelliSense.
         CS1591 is suppressed so undocumented members don't flood the build while we document incrementally. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Licensing/PVAD.Licensing/PVAD.Licensing.csproj" />
    <InternalsVisibleTo Include="PVAD.Infrastructure.Pdf" />
    <InternalsVisibleTo Include="PVAD.Infrastructure.Pdf.Tests" />
    <InternalsVisibleTo Include="PVAD.Importer" />
    <InternalsVisibleTo Include="PVAD.WebApi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="14.4.0.100" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.100" />
    <PackageReference Include="Unicode.Bidi" Version="0.4.0" GeneratePathProperty="true" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgUnicode_Bidi)/THIRD-PARTY-NOTICES.md" Link="third-party/Unicode.Bidi/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgUnicode_Bidi)/UNICODE-LICENSE.txt" Link="third-party/Unicode.Bidi/UNICODE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../assets/licenses/Unicode.Bidi-LICENSE.txt" Link="third-party/Unicode.Bidi/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
