<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PXA.FileImporter.ImageOcr/PXA.FileImporter.ImageOcr.csproj" />
    <ProjectReference Include="../../PXA.WebApi/PXA.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/PXA.FileImporter.ImageOcr/tessdata/*.traineddata" Link="tessdata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/PXA.FileImporter.ImageOcr/native/**" Link="native/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/TableSamples/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/RealSamples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
