<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Canvas.Export.Tests/**/*.cs"
             Exclude="../Canvas.Export.Tests/bin/**;../Canvas.Export.Tests/obj/**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Canvas.Core.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Canvas.Application/Canvas.Application.csproj" />
    <ProjectReference Include="../../src/Canvas.Infrastructure.Converters/Canvas.Infrastructure.Converters.csproj" />
    <ProjectReference Include="../../src/Canvas.Infrastructure.Word/Canvas.Infrastructure.Word.csproj" />
    <ProjectReference Include="../../src/Canvas.Infrastructure.Spreadsheet/Canvas.Infrastructure.Spreadsheet.csproj" />
    <ProjectReference Include="../../Canvas.WebApi/PXA.WebApi.csproj" />
  </ItemGroup>

</Project>
