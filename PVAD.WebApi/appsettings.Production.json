{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Observability": {
    "AllowTemporaryDebugLogging": false,
    "DebugLoggingExpiresAtUtc": null,
    "EnableOcrFailureInjection": false
  },
  "AdminSecurity": {
    "RequireExplicitSystemOperators": true,
    "SystemOperatorEmails": []
  },
  "ProductAccess": {
    "Enabled": true
  },
  "Registration": {
    "RequireDatabaseLegalDocuments": true
  }
}
